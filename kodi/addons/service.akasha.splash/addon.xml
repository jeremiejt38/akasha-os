<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.akasha.splash" name="Akasha Splash" version="1.0.0" provider-name="Akasha">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.service" library="service.py" start="startup">
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Plays the Akasha OS intro video on boot.</summary>
        <summary lang="fr_FR">Joue la video d'intro Akasha OS au demarrage.</summary>
        <description lang="en_GB">Plays a fullscreen intro video once per boot when Kodi starts. Skippable with any button press.</description>
        <platform>all</platform>
        <license>MIT</license>
    </extension>
</addon>
