<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.akasha.settings" name="Akasha Settings" version="1.0.0" provider-name="Akasha">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="fr_FR">Paramètres Akasha OS</summary>
        <summary lang="en_GB">Akasha OS Settings</summary>
        <description lang="fr_FR">Configuration centralisée des paramètres Akasha : veille, CEC, ventilateur, écran de veille, et plus.</description>
        <description lang="en_GB">Centralized Akasha settings: sleep, CEC, fan, screensaver, and more.</description>
        <platform>all</platform>
    </extension>
</addon>
