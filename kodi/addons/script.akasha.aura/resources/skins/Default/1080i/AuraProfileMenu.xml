        <control type="group">
            <left>0</left>
            <top>0</top>
            <animation effect="fade" start="0" end="100" time="180" tween="quadratic" easing="out">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="120" tween="quadratic" easing="in">WindowClose</animation>

            <!-- Dim backdrop: starts right of the rail (x420) so the
                 expanded sidebar stays readable behind the sheet, like
                 Plex. -->
