<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1198">
    <defaultcontrol>7030</defaultcontrol>
    <zorder>2</zorder>
    <controls>
        <!-- Fullscreen background -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF10131A">white.png</texture>
        </control>

        <!-- Breadcrumb header -->
        <control type="label" id="7000">
            <left>60</left>
            <top>40</top>
            <width>1600</width>
            <height>60</height>
            <font>font16</font>
            <label>-</label>
            <textcolor>FF6C8CFF</textcolor>
        </control>

        <!-- Back button -->
        <control type="button" id="7030">
            <left>1700</left>
            <top>40</top>
            <width>160</width>
            <height>50</height>
            <font>font12</font>
            <label>Retour</label>
            <textcolor>BBFFFFFF</textcolor>
            <focusedcolor>FFFFFFFF</focusedcolor>
            <texturefocus colordiffuse="FF6C8CFF">white.png</texturefocus>
            <ondown>7010</ondown>
        </control>

        <!-- Status line -->
        <control type="label" id="7020">
            <left>60</left>
            <top>110</top>
            <width>1800</width>
            <height>36</height>
            <font>font12</font>
            <label>-</label>
            <textcolor>77FFFFFF</textcolor>
        </control>

        <!-- Poster grid: seasons, then episodes of the selected season -->
        <control type="list" id="7010">
            <left>60</left>
            <top>170</top>
            <width>1800</width>
            <height>850</height>
            <orientation>horizontal</orientation>
            <onup>7030</onup>
            <ondown>7010</ondown>
            <itemlayout width="220" height="330">
                <control type="image">
                    <left>5</left>
                    <top>0</top>
                    <width>190</width>
                    <height>280</height>
                    <aspectratio>scale</aspectratio>
                    <texture background="true">$INFO[ListItem.Art(thumb)]</texture>
                </control>
                <control type="label">
                    <left>5</left>
                    <top>284</top>
                    <width>210</width>
                    <height>26</height>
                    <font>font10</font>
                    <label>$INFO[ListItem.Label]</label>
                    <textcolor>77FFFFFF</textcolor>
                    <wrapmultiline>false</wrapmultiline>
                </control>
            </itemlayout>
            <focusedlayout width="220" height="330">
                <control type="image">
                    <left>1</left>
                    <top>-4</top>
                    <width>198</width>
                    <height>288</height>
                    <texture colordiffuse="FF6C8CFF">white.png</texture>
                </control>
                <control type="image">
                    <left>5</left>
                    <top>0</top>
                    <width>190</width>
                    <height>280</height>
                    <aspectratio>scale</aspectratio>
                    <texture background="true">$INFO[ListItem.Art(thumb)]</texture>
                </control>
                <control type="label">
                    <left>5</left>
                    <top>284</top>
                    <width>210</width>
                    <height>26</height>
                    <font>font10</font>
                    <label>$INFO[ListItem.Label]</label>
                    <textcolor>FFFFFFFF</textcolor>
                    <wrapmultiline>false</wrapmultiline>
                </control>
            </focusedlayout>
        </control>
    </controls>
</window>
