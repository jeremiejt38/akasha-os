<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1210">
    <!-- Plex PIN pad for PIN-protected profiles: dark screen, title,
         four fill-in dots (AuraPinDot0..3), an error line, and a 3-col
         numeric pad (digits 1-9, 0, backspace). Remote digit keys are
         also accepted by aura_switch. -->
    <defaultcontrol>9210</defaultcontrol>
    <controls>
        <control type="group">
            <left>0</left>
            <top>0</top>
            <animation effect="fade" start="0" end="100" time="150" tween="quadratic" easing="out">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="120" tween="quadratic" easing="in">WindowClose</animation>

            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>1920</width>
                <height>1080</height>
                <texture colordiffuse="FA080808">white.png</texture>
            </control>

            <control type="label" id="9201">
                <left>0</left>
                <top>180</top>
                <width>1920</width>
                <height>52</height>
                <font>font_aura_head_bold</font>
                <align>center</align>
                <textcolor>FFFFFFFF</textcolor>
            </control>

            <!-- Four PIN dots: outline ring always, white fill driven
                 by Window.Property(AuraPinDotN). -->
            <control type="image">
                <left>864</left>
                <top>300</top>
                <width>22</width>
                <height>22</height>
                <texture>cast-ring.png</texture>
            </control>
            <control type="image">
                <left>924</left>
                <top>300</top>
                <width>22</width>
                <height>22</height>
                <texture>cast-ring.png</texture>
            </control>
            <control type="image">
                <left>984</left>
                <top>300</top>
                <width>22</width>
                <height>22</height>
                <texture>cast-ring.png</texture>
            </control>
            <control type="image">
                <left>1044</left>
                <top>300</top>
                <width>22</width>
                <height>22</height>
                <texture>cast-ring.png</texture>
            </control>
            <control type="image">
                <left>864</left>
                <top>300</top>
                <width>22</width>
                <height>22</height>
                <texture colordiffuse="FFFFFFFF">circle.png</texture>
                <visible>!String.IsEmpty(Window.Property(AuraPinDot0))</visible>
            </control>
            <control type="image">
                <left>924</left>
                <top>300</top>
                <width>22</width>
                <height>22</height>
                <texture colordiffuse="FFFFFFFF">circle.png</texture>
                <visible>!String.IsEmpty(Window.Property(AuraPinDot1))</visible>
            </control>
            <control type="image">
                <left>984</left>
                <top>300</top>
                <width>22</width>
                <height>22</height>
                <texture colordiffuse="FFFFFFFF">circle.png</texture>
                <visible>!String.IsEmpty(Window.Property(AuraPinDot2))</visible>
            </control>
            <control type="image">
                <left>1044</left>
                <top>300</top>
                <width>22</width>
                <height>22</height>
                <texture colordiffuse="FFFFFFFF">circle.png</texture>
                <visible>!String.IsEmpty(Window.Property(AuraPinDot3))</visible>
            </control>

            <control type="label" id="9202">
                <left>0</left>
                <top>366</top>
                <width>1920</width>
                <height>30</height>
                <font>font_aura_meta</font>
                <align>center</align>
                <textcolor>FFE5A00D</textcolor>
            </control>

            <control type="panel" id="9210">
                <left>785</left>
                <top>430</top>
                <width>350</width>
                <height>500</height>
                <itemlayout width="116" height="116">
                    <control type="image">
                        <left>10</left>
                        <top>10</top>
                        <width>96</width>
                        <height>96</height>
                        <texture colordiffuse="FF232323">circle.png</texture>
                    </control>
                    <control type="label">
                        <left>10</left>
                        <top>10</top>
                        <width>96</width>
                        <height>96</height>
                        <font>font_aura_section_bold</font>
                        <align>center</align>
                        <aligny>center</aligny>
                        <textcolor>FFFFFFFF</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="image">
                        <left>38</left>
                        <top>38</top>
                        <width>40</width>
                        <height>40</height>
                        <texture>$INFO[ListItem.Art(icon)]</texture>
                        <visible>String.IsEmpty(ListItem.Label)</visible>
                    </control>
                </itemlayout>
                <focusedlayout width="116" height="116">
                    <control type="image">
                        <left>10</left>
                        <top>10</top>
                        <width>96</width>
                        <height>96</height>
                        <texture colordiffuse="FFFFFFFF">circle.png</texture>
                    </control>
                    <control type="label">
                        <left>10</left>
                        <top>10</top>
                        <width>96</width>
                        <height>96</height>
                        <font>font_aura_section_bold</font>
                        <align>center</align>
                        <aligny>center</aligny>
                        <textcolor>FF101010</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="image">
                        <left>38</left>
                        <top>38</top>
                        <width>40</width>
                        <height>40</height>
                        <texture colordiffuse="FF101010">$INFO[ListItem.Art(icon)]</texture>
                        <visible>String.IsEmpty(ListItem.Label)</visible>
                    </control>
                </focusedlayout>
            </control>
        </control>
    </controls>
</window>
