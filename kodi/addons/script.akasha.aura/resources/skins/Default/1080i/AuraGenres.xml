<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1200">
    <defaultcontrol>6010</defaultcontrol>
    <zorder>2</zorder>
    <controls>
        <!-- Fullscreen background -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF10131A">white.png</texture>
        </control>

        <!-- Header -->
        <control type="label" id="6000">
            <left>60</left>
            <top>40</top>
            <width>1200</width>
            <height>60</height>
            <font>font16</font>
            <label>Categories</label>
            <textcolor>FF6C8CFF</textcolor>
        </control>

        <!-- Back button -->
        <control type="button" id="6030">
            <left>1700</left>
            <top>40</top>
            <width>160</width>
            <height>50</height>
            <font>font12</font>
            <label>Retour</label>
            <textcolor>BBFFFFFF</textcolor>
            <focusedcolor>FFFFFFFF</focusedcolor>
            <texturefocus colordiffuse="FF6C8CFF">white.png</texturefocus>
            <ondown>6010</ondown>
        </control>

        <!-- Status line -->
        <control type="label" id="6020">
            <left>60</left>
            <top>120</top>
            <width>1800</width>
            <height>30</height>
            <font>font12</font>
            <label>-</label>
            <textcolor>77FFFFFF</textcolor>
        </control>

        <!-- Genre tiles: wrapping grid, 6 tiles per row -->
        <control type="panel" id="6010">
            <left>60</left>
            <top>180</top>
            <width>1800</width>
            <height>800</height>
            <onup>6030</onup>
            <itemlayout width="280" height="90">
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>270</width>
                    <height>70</height>
                    <texture colordiffuse="FF262B3D">white.png</texture>
                </control>
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>270</width>
                    <height>70</height>
                    <font>font12</font>
                    <align>center</align>
                    <aligny>center</aligny>
                    <label>$INFO[ListItem.Label]</label>
                    <textcolor>CCFFFFFF</textcolor>
                </control>
            </itemlayout>
            <focusedlayout width="280" height="90">
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>270</width>
                    <height>70</height>
                    <texture colordiffuse="FF6C8CFF">white.png</texture>
                </control>
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>270</width>
                    <height>70</height>
                    <font>font12</font>
                    <align>center</align>
                    <aligny>center</aligny>
                    <label>$INFO[ListItem.Label]</label>
                    <textcolor>FFFFFFFF</textcolor>
                </control>
            </focusedlayout>
        </control>
    </controls>
</window>
