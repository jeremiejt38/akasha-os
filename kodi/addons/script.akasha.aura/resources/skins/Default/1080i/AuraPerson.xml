<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1204">
    <!-- The filmography list (7310) is populated from Python, so it is
         empty when Kodi resolves the default control. A 1px invisible
         pass-through button keeps the boot focus warning quiet; its
         edges all lead back to the real list, and Python moves focus
         there in onInit anyway. -->
    <defaultcontrol>7001</defaultcontrol>
    <zorder>3</zorder>
    <controls>
        <control type="button" id="7001">
            <left>0</left>
            <top>0</top>
            <width>1</width>
            <height>1</height>
            <texturenofocus>-</texturenofocus>
            <texturefocus>-</texturefocus>
            <onup>7310</onup>
            <onleft>7310</onleft>
            <onright>7310</onright>
            <ondown>7310</ondown>
        </control>
        <!-- Plex-style person page: circular photo, name, and the
             server-side filmography as a poster row (Cast & Crew pick
             on the detail page opens this). -->

        <control type="group">
            <left>0</left>
            <top>0</top>
            <animation effect="fade" start="0" end="100" time="200" tween="quadratic" easing="out">WindowOpen</animation>
            <animation effect="zoom" start="102" end="100" center="auto" time="250" tween="quadratic" easing="out">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="150" tween="quadratic" easing="in">WindowClose</animation>

            <!-- Base -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>1920</width>
                <height>1080</height>
                <texture colordiffuse="FF10131A">white.png</texture>
            </control>

            <!-- Circular photo -->
            <control type="image" id="7301">
                <left>150</left>
                <top>120</top>
                <width>220</width>
                <height>220</height>
                <aspectratio>scale</aspectratio>
            </control>
            <control type="image">
                <left>150</left>
                <top>120</top>
                <width>220</width>
                <height>220</height>
                <texture colordiffuse="FF10131A">cast-mask.png</texture>
            </control>

            <!-- Name -->
            <control type="label" id="7302">
                <left>430</left>
                <top>180</top>
                <width>1400</width>
                <height>80</height>
                <font>font_aura_head_bold</font>
                <textcolor>FFFFFFFF</textcolor>
                <wrapmultiline>false</wrapmultiline>
            </control>

            <!-- Filmography title -->
            <control type="label" id="7305">
                <left>150</left>
                <top>430</top>
                <width>1000</width>
                <height>44</height>
                <font>font_aura_mini_bold</font>
                <textcolor>FFFFFFFF</textcolor>
                <visible>!String.IsEmpty(Window.Property(AuraPersonRowTitle))</visible>
            </control>

            <!-- Empty state -->
            <control type="label">
                <left>150</left>
                <top>430</top>
                <width>1400</width>
                <height>44</height>
                <font>font_aura_mini</font>
                <textcolor>AAFFFFFF</textcolor>
                <label>$ADDON[script.akasha.aura 33126]</label>
                <visible>!String.IsEmpty(Window.Property(AuraPersonEmpty))</visible>
            </control>

            <!-- Filmography poster row -->
            <control type="list" id="7310">
                <left>142</left>
                <top>490</top>
                <width>1800</width>
                <height>340</height>
                <orientation>horizontal</orientation>
                <scrolltime>200</scrolltime>
                <visible>!String.IsEmpty(Window.Property(AuraPersonRowTitle))</visible>
                <itemlayout width="212" height="340">
                    <control type="image">
                        <left>0</left>
                        <top>0</top>
                        <width>200</width>
                        <height>300</height>
                        <aspectratio>scale</aspectratio>
                        <texture background="true">$INFO[ListItem.Art(poster)]</texture>
                    </control>
                    <control type="image">
                        <left>0</left>
                        <top>0</top>
                        <width>200</width>
                        <height>300</height>
                        <texture colordiffuse="FF10131A">poster-corners.png</texture>
                    </control>
                    <control type="image">
                        <left>150</left>
                        <top>10</top>
                        <width>40</width>
                        <height>40</height>
                        <texture colordiffuse="CC10131A">circle.png</texture>
                        <visible>String.IsEqual(ListItem.Property(watched),1)</visible>
                    </control>
                    <control type="image">
                        <left>158</left>
                        <top>18</top>
                        <width>24</width>
                        <height>24</height>
                        <texture>check.png</texture>
                        <visible>String.IsEqual(ListItem.Property(watched),1)</visible>
                    </control>
                    <control type="label">
                        <left>0</left>
                        <top>306</top>
                        <width>200</width>
                        <height>28</height>
                        <font>font_aura_mini</font>
                        <label>$INFO[ListItem.Label]</label>
                        <textcolor>DDFFFFFF</textcolor>
                        <wrapmultiline>false</wrapmultiline>
                    </control>
                </itemlayout>
                <focusedlayout width="212" height="340">
                    <control type="image">
                        <left>0</left>
                        <top>0</top>
                        <width>200</width>
                        <height>300</height>
                        <aspectratio>scale</aspectratio>
                        <texture background="true">$INFO[ListItem.Art(poster)]</texture>
                    </control>
                    <control type="image">
                        <left>0</left>
                        <top>0</top>
                        <width>200</width>
                        <height>300</height>
                        <texture colordiffuse="FF10131A">poster-corners.png</texture>
                        <animation effect="zoom" start="100" end="104" center="auto" time="150" reversible="true">Focus</animation>
                    </control>
                    <control type="image">
                        <left>-4</left>
                        <top>-4</top>
                        <width>208</width>
                        <height>308</height>
                        <texture colordiffuse="B3FFFFFF" border="20">focus-ring.png</texture>
                        <animation effect="zoom" start="100" end="104" center="auto" time="150" reversible="true">Focus</animation>
                    </control>
                    <control type="image">
                        <left>150</left>
                        <top>10</top>
                        <width>40</width>
                        <height>40</height>
                        <texture colordiffuse="CC10131A">circle.png</texture>
                        <visible>String.IsEqual(ListItem.Property(watched),1)</visible>
                    </control>
                    <control type="image">
                        <left>158</left>
                        <top>18</top>
                        <width>24</width>
                        <height>24</height>
                        <texture>check.png</texture>
                        <visible>String.IsEqual(ListItem.Property(watched),1)</visible>
                    </control>
                    <control type="label">
                        <left>0</left>
                        <top>306</top>
                        <width>200</width>
                        <height>28</height>
                        <font>font_aura_mini_bold</font>
                        <label>$INFO[ListItem.Label]</label>
                        <textcolor>FFFFFFFF</textcolor>
                        <wrapmultiline>false</wrapmultiline>
                    </control>
                </focusedlayout>
            </control>
        </control>
    </controls>
</window>
