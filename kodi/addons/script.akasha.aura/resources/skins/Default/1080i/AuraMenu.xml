<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1208">
    <defaultcontrol>9010</defaultcontrol>
    <zorder>3</zorder>
    <controls>
        <control type="group">
            <left>0</left>
            <top>0</top>
            <animation effect="fade" start="0" end="100" time="180" tween="quadratic" easing="out">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="120" tween="quadratic" easing="in">WindowClose</animation>

            <!-- Dim backdrop -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>1920</width>
                <height>1080</height>
                <texture colordiffuse="B3000000">white.png</texture>
            </control>

            <!-- Centered dark panel (position/size set from Python) -->
            <control type="image" id="9000">
                <texture colordiffuse="FF1F222B" border="26">rounded-solid.png</texture>
            </control>
            <control type="label" id="9005">
                <font>font_aura_mini_bold</font>
                <textcolor>CCFFFFFF</textcolor>
                <wrapmultiline>false</wrapmultiline>
            </control>
            <control type="textbox" id="9006">
                <font>font_aura_mini</font>
                <textcolor>CCFFFFFF</textcolor>
            </control>
            <control type="list" id="9010">
                <scrolltime>140</scrolltime>
                <itemlayout height="64">
                    <control type="label">
                        <left>40</left>
                        <top>0</top>
                        <width>560</width>
                        <height>64</height>
                        <aligny>center</aligny>
                        <font>font_aura_mini</font>
                        <label>$INFO[ListItem.Label]</label>
                        <textcolor>DDFFFFFF</textcolor>
                        <wrapmultiline>false</wrapmultiline>
                    </control>
                </itemlayout>
                <focusedlayout height="64">
                    <control type="image">
                        <left>12</left>
                        <top>6</top>
                        <width>616</width>
                        <height>52</height>
                        <texture colordiffuse="FFE8EAED" border="26">rounded-solid.png</texture>
                    </control>
                    <control type="label">
                        <left>40</left>
                        <top>0</top>
                        <width>560</width>
                        <height>64</height>
                        <aligny>center</aligny>
                        <font>font_aura_mini_bold</font>
                        <label>$INFO[ListItem.Label]</label>
                        <textcolor>FF10131A</textcolor>
                        <wrapmultiline>false</wrapmultiline>
                    </control>
                </focusedlayout>
                <content />
            </control>
        </control>
    </controls>
</window>
