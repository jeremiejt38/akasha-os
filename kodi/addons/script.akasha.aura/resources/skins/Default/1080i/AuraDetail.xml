        <control type="label" id="7051">
            <left>1150</left>
            <top>584</top>
            <width>350</width>
            <height>44</height>
            <font>font_mini_bold</font>
            <align>center</align>
            <aligny>center</aligny>
            <textcolor>FFFFFFFF</textcolor>
            <visible>!String.IsEmpty(Window.Property(AuraDetailVideoBadge))</visible>
