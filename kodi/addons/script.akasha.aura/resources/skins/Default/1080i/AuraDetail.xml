                    <height>26</height>
                    <font>font_mini</font>
                    <align>center</align>
                    <label>$INFO[ListItem.Label]</label>
                    <textcolor>DDFFFFFF</textcolor>
                    <wrapmultiline>false</wrapmultiline>
                </control>
                <control type="label">
                    <left>0</left>
                    <top>194</top>
                    <width>200</width>
                    <height>24</height>
                    <font>font_mini</font>
