<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1199">
    <defaultcontrol>7100</defaultcontrol>
    <zorder>3</zorder>
    <controls>
        <!-- Plex-style item detail page (plan 2e7c9375, docs/plex-parity/SPEC.md).
             Right-weighted backdrop, dimmed gradient, then title/logo, meta
             line, rating chips, synopsis, director, action pills, media
             badges and a circular Cast &amp; Crew row. -->

        <!-- Base -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF10131A">white.png</texture>
        </control>

        <!-- Backdrop, full-bleed right-anchored like Plex -->
        <control type="image" id="7001">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>765</height>
            <aspectratio align="right" aligny="top">scale</aspectratio>
            <fadetime>200</fadetime>
            <texture background="true"></texture>
        </control>
        <!-- Dim + left gradient over the backdrop -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>scrim-hero.png</texture>
        </control>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="7310131A">white.png</texture>
        </control>

        <!-- Clear logo (when available) or text title -->
        <control type="image" id="7010">
            <left>105</left>
            <top>140</top>
            <width>720</width>
            <height>160</height>
            <aspectratio align="left" aligny="bottom">keep</aspectratio>
            <fadetime>150</fadetime>
            <texture background="true"></texture>
            <visible>!String.IsEmpty(Window.Property(AuraDetailLogo))</visible>
        </control>
        <control type="label" id="7011">
            <left>105</left>
            <top>200</top>
            <width>1100</width>
            <height>70</height>
            <font>font_main_bold</font>
            <textcolor>FFFFFFFF</textcolor>
            <visible>String.IsEmpty(Window.Property(AuraDetailLogo))</visible>
        </control>

        <!-- Meta line: year - duration - genres -->
        <control type="label" id="7020">
            <left>105</left>
            <top>310</top>
            <width>1100</width>
            <height>36</height>
            <font>font_mini</font>
            <textcolor>EEFFFFFF</textcolor>
        </control>

        <!-- Rating chips row (positions/widths computed in Python):
             slot 0 = content rating, slot 1 = critic, slot 2 = audience -->
        <control type="image" id="7021">
            <left>105</left>
            <top>356</top>
            <width>90</width>
            <height>36</height>
            <texture colordiffuse="3DFFFFFF" border="6">rounded-solid.png</texture>
            <visible>!String.IsEmpty(Window.Property(AuraDetailChip0))</visible>
        </control>
        <control type="label" id="7022">
            <left>105</left>
            <top>356</top>
            <width>90</width>
            <height>36</height>
            <font>font_mini_bold</font>
            <align>center</align>
            <aligny>center</aligny>
            <textcolor>FFFFFFFF</textcolor>
            <visible>!String.IsEmpty(Window.Property(AuraDetailChip0))</visible>
        </control>
        <control type="image" id="7023">
            <left>205</left>
            <top>356</top>
            <width>120</width>
            <height>36</height>
            <texture colordiffuse="3DFFFFFF" border="6">rounded-solid.png</texture>
            <visible>!String.IsEmpty(Window.Property(AuraDetailChip1))</visible>
        </control>
        <control type="label" id="7024">
            <left>205</left>
            <top>356</top>
            <width>120</width>
            <height>36</height>
            <font>font_mini</font>
            <align>center</align>
            <aligny>center</aligny>
            <textcolor>FFFFFFFF</textcolor>
            <visible>!String.IsEmpty(Window.Property(AuraDetailChip1))</visible>
