            <left>1150</left>
            <top>584</top>
            <width>350</width>
            <height>44</height>
            <texture colordiffuse="B3000000" border="8">rounded-solid.png</texture>
            <visible>!String.IsEmpty(Window.Property(AuraDetailVideoBadge))</visible>
