        <control type="image" id="7025">
            <left>335</left>
            <top>356</top>
            <width>130</width>
            <height>36</height>
            <texture colordiffuse="3DFFFFFF" border="6">rounded-solid.png</texture>
            <visible>!String.IsEmpty(Window.Property(AuraDetailChip2))</visible>
        </control>
        <control type="label" id="7026">
            <left>335</left>
            <top>356</top>
            <width>130</width>
            <height>36</height>
            <font>font_mini</font>
            <align>center</align>
            <aligny>center</aligny>
            <textcolor>FFFFFFFF</textcolor>
            <visible>!String.IsEmpty(Window.Property(AuraDetailChip2))</visible>
        </control>

        <!-- Synopsis (3 lines like Plex) -->
        <control type="textbox" id="7030">
            <left>105</left>
            <top>412</top>
            <width>1150</width>
            <height>96</height>
            <font>font_mini</font>
            <textcolor>DDFFFFFF</textcolor>
        </control>

        <!-- Director / creator line -->
        <control type="label" id="7040">
            <left>105</left>
            <top>518</top>
            <width>1100</width>
            <height>32</height>
            <font>font_mini</font>
            <textcolor>99FFFFFF</textcolor>
        </control>

        <!-- Action row: Watch/Resume pill + watchlist + watched + more -->
        <control type="button" id="7100">
            <left>105</left>
            <top>576</top>
            <width>250</width>
            <height>64</height>
            <font>font_tiny_bold</font>
            <align>center</align>
            <aligny>center</aligny>
            <label>Regarder</label>
            <textcolor>FF1A1A1A</textcolor>
            <focusedcolor>FF1A1A1A</focusedcolor>
            <texturenofocus colordiffuse="FFFFFFFF" border="32">rounded-solid.png</texturenofocus>
            <texturefocus colordiffuse="FFFFFFFF" border="32">rounded-solid.png</texturefocus>
            <onright>7103</onright>
            <ondown>7110</ondown>
        </control>
        <control type="button" id="7103">
            <left>375</left>
            <top>576</top>
            <width>64</width>
            <height>64</height>
            <label>+</label>
            <font>font_main_bold</font>
            <align>center</align>
            <aligny>center</aligny>
            <onleft>7100</onleft>
            <onright>7101</onright>
            <ondown>7110</ondown>
            <textcolor>BBFFFFFF</textcolor>
            <focusedcolor>FF1A1A1A</focusedcolor>
            <texturenofocus colordiffuse="59FFFFFF">circle.png</texturenofocus>
            <texturefocus colordiffuse="FFFFFFFF">circle.png</texturefocus>
        </control>
        <control type="button" id="7101">
            <left>459</left>
            <top>576</top>
            <width>64</width>
            <height>64</height>
            <label></label>
            <onleft>7103</onleft>
            <onright>7102</onright>
            <ondown>7110</ondown>
            <texturenofocus colordiffuse="59FFFFFF">circle.png</texturenofocus>
            <texturefocus colordiffuse="FFFFFFFF">circle.png</texturefocus>
        </control>
        <control type="image">
            <left>479</left>
            <top>596</top>
            <width>24</width>
            <height>24</height>
            <texture colordiffuse="FFFFFFFF">check.png</texture>
            <visible>String.IsEqual(Window.Property(AuraDetailWatched),1)</visible>
        </control>
        <control type="button" id="7102">
            <left>543</left>
            <top>576</top>
            <width>64</width>
            <height>64</height>
            <label>...</label>
            <font>font_tiny_bold</font>
            <align>center</align>
            <aligny>center</aligny>
            <onleft>7101</onleft>
            <ondown>7110</ondown>
            <textcolor>BBFFFFFF</textcolor>
            <focusedcolor>FF1A1A1A</focusedcolor>
            <texturenofocus colordiffuse="59FFFFFF">circle.png</texturenofocus>
            <texturefocus colordiffuse="FFFFFFFF">circle.png</texturefocus>
        </control>

