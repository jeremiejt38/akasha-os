            </control>
            <control type="label">
                <left>72</left>
                <top>135</top>
                <width>1780</width>
                <height>30</height>
                <font>font11</font>
                <label>Double Home pour ouvrir</label>
                <textcolor>77FFFFFF</textcolor>
            </control>
            <control type="panel" id="100">
                <left>60</left>
                <top>210</top>
                <width>1800</width>
                <height>700</height>
                <onup>100</onup>
                <ondown>100</ondown>
                <itemlayout width="300" height="230">
                    <control type="image">
                        <left>15</left>
                        <top>10</top>
                        <width>270</width>
                        <height>160</height>
                        <aspectratio>keep</aspectratio>
                        <texture background="true">$INFO[ListItem.Art(thumb)]</texture>
                    </control>
                    <control type="label">
                        <left>20</left>
                        <top>175</top>
                        <width>260</width>
                        <height>40</height>
