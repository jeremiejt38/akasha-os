                        <font>font12</font>
                        <label>$INFO[ListItem.Label]</label>
                        <textcolor>CCFFFFFF</textcolor>
                    </control>
                </itemlayout>
                <focusedlayout width="300" height="230">
                    <control type="image">
                        <left>5</left>
                        <top>0</top>
                        <width>290</width>
                        <height>220</height>
                        <texture colordiffuse="FF6C8CFF" border="16">rounded-solid.png</texture>
