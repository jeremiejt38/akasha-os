        </control>
        <control type="group">
            <animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
            <control type="label">
                <left>70</left>
                <top>80</top>
                <width>1780</width>
                <height>55</height>
                <font>font16</font>
                <label>Applications recentes</label>
