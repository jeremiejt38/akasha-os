<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1209">
    <!-- Plex's "Who's watching?" profile picker (45-home-again.png):
         near-black fullscreen, centered bold title, a horizontally
         centered row of big round avatars with lock badges on PIN
         profiles and a '+ Add user' ghost tile. The user panel (9100)
         is centered by aura_switch once the member count is known. -->
    <defaultcontrol>9100</defaultcontrol>
    <controls>
        <control type="group">
            <left>0</left>
            <top>0</top>
            <animation effect="fade" start="0" end="100" time="180" tween="quadratic" easing="out">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="120" tween="quadratic" easing="in">WindowClose</animation>

            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>1920</width>
                <height>1080</height>
                <texture colordiffuse="FA080808">white.png</texture>
            </control>

            <control type="label" id="9101">
                <left>0</left>
                <top>126</top>
                <width>1920</width>
                <height>60</height>
                <font>font_aura_info_black_doublerow</font>
                <align>center</align>
                <textcolor>FFFFFFFF</textcolor>
            </control>

            <control type="panel" id="9100">
                <left>560</left>
                <top>268</top>
                <width>800</width>
                <height>290</height>
                <orientation>horizontal</orientation>
                <onleft>9100</onleft>
                <onright>9100</onright>
                <onup>9100</onup>
                <ondown>9100</ondown>
                <itemlayout width="280" height="280">
                    <control type="image">
                        <left>45</left>
                        <top>0</top>
                        <width>190</width>
                        <height>190</height>
                        <aspectratio>scale</aspectratio>
                        <texture>$INFO[ListItem.Art(thumb)]</texture>
                    </control>
                    <control type="image">
                        <left>45</left>
                        <top>0</top>
                        <width>190</width>
                        <height>190</height>
                        <texture colordiffuse="FA080808">cast-mask.png</texture>
                    </control>
                    <control type="image">
                        <left>185</left>
                        <top>140</top>
                        <width>48</width>
                        <height>48</height>
                        <texture colordiffuse="FFFFFFFF">circle.png</texture>
                        <visible>!String.IsEmpty(ListItem.Property(protected))</visible>
                    </control>
                    <control type="image">
                        <left>196</left>
                        <top>151</top>
                        <width>26</width>
                        <height>26</height>
                        <texture>icon-lock-dark.png</texture>
                        <visible>!String.IsEmpty(ListItem.Property(protected))</visible>
                    </control>
                    <control type="label">
                        <left>0</left>
                        <top>206</top>
                        <width>280</width>
                        <height>30</height>
                        <font>font_aura_small</font>
                        <align>center</align>
                        <textcolor>FF9A9A9A</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                </itemlayout>
                <focusedlayout width="280" height="280">
                    <control type="image">
                        <left>40</left>
                        <top>-5</top>
                        <width>200</width>
                        <height>200</height>
                        <texture>cast-ring.png</texture>
                    </control>
                    <control type="image">
                        <left>45</left>
                        <top>0</top>
                        <width>190</width>
                        <height>190</height>
                        <aspectratio>scale</aspectratio>
                        <texture>$INFO[ListItem.Art(thumb)]</texture>
                    </control>
                    <control type="image">
                        <left>45</left>
                        <top>0</top>
                        <width>190</width>
                        <height>190</height>
                        <texture colordiffuse="FA080808">cast-mask.png</texture>
                    </control>
                    <control type="image">
                        <left>185</left>
                        <top>140</top>
                        <width>48</width>
                        <height>48</height>
                        <texture colordiffuse="FFFFFFFF">circle.png</texture>
                        <visible>!String.IsEmpty(ListItem.Property(protected))</visible>
                    </control>
                    <control type="image">
                        <left>196</left>
                        <top>151</top>
                        <width>26</width>
                        <height>26</height>
                        <texture>icon-lock-dark.png</texture>
                        <visible>!String.IsEmpty(ListItem.Property(protected))</visible>
                    </control>
                    <control type="label">
                        <left>0</left>
                        <top>206</top>
                        <width>280</width>
                        <height>30</height>
                        <font>font_aura_small_bold</font>
                        <align>center</align>
                        <textcolor>FFFFFFFF</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                </focusedlayout>
            </control>
        </control>
    </controls>
</window>
