<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1209">
    <!-- Plex's "Who's watching?" profile picker (45-home-again.png):
         near-black fullscreen, centered bold title, a horizontally
         centered row of big round avatars with lock badges on PIN
         profiles and a '+ Add user' ghost tile. The user panel (9100)
         is centered by aura_switch once the member count is known. -->
    <defaultcontrol>9100</defaultcontrol>
    <controls>
        <control type="group">
            <left>0</left>
            <top>0</top>
            <animation effect="fade" start="0" end="100" time="180" tween="quadratic" easing="out">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="120" tween="quadratic" easing="in">WindowClose</animation>

            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>1920</width>
                <height>1080</height>
                <texture colordiffuse="FA080808">white.png</texture>
            </control>

            <control type="label" id="9101">
                <left>0</left>
                <top>130</top>
                <width>1920</width>
                <height>80</height>
                <font>font_aura_title_black</font>
                <align>center</align>
                <textcolor>FFFFFFFF</textcolor>
            </control>

            <control type="panel" id="9100">
                <left>510</left>
                <top>266</top>
                <width>900</width>
                <height>350</height>
                <orientation>horizontal</orientation>
                <onleft>9100</onleft>
                <onright>9100</onright>
                <onup>9100</onup>
                <ondown>9100</ondown>
                <itemlayout width="300" height="350">
                    <control type="image">
                        <left>40</left>
                        <top>42</top>
                        <width>220</width>
                        <height>220</height>
                        <aspectratio>scale</aspectratio>
                        <texture>$INFO[ListItem.Art(thumb)]</texture>
                    </control>
                    <control type="image">
                        <left>40</left>
                        <top>42</top>
                        <width>220</width>
                        <height>220</height>
                        <texture colordiffuse="FA080808">cast-mask.png</texture>
                    </control>
                    <control type="image">
                        <left>208</left>
                        <top>213</top>
                        <width>54</width>
                        <height>54</height>
                        <texture colordiffuse="FFFFFFFF">circle.png</texture>
                        <visible>!String.IsEmpty(ListItem.Property(protected))</visible>
                    </control>
                    <control type="image">
                        <left>220</left>
                        <top>225</top>
                        <width>30</width>
                        <height>30</height>
                        <texture>icon-lock-amber.png</texture>
                        <visible>!String.IsEmpty(ListItem.Property(protected))</visible>
                    </control>
                    <control type="label">
                        <left>0</left>
                        <top>283</top>
                        <width>300</width>
                        <height>30</height>
                        <font>font_aura_small</font>
                        <align>center</align>
                        <textcolor>FF9A9A9A</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                </itemlayout>
                <focusedlayout width="300" height="350">
                    <control type="image">
                        <left>-2</left>
                        <top>0</top>
                        <width>304</width>
                        <height>304</height>
                        <texture>cast-ring.png</texture>
                    </control>
                    <control type="image">
                        <left>18</left>
                        <top>20</top>
                        <width>264</width>
                        <height>264</height>
                        <aspectratio>scale</aspectratio>
                        <texture>$INFO[ListItem.Art(thumb)]</texture>
                    </control>
                    <control type="image">
                        <left>18</left>
                        <top>20</top>
                        <width>264</width>
                        <height>264</height>
                        <texture colordiffuse="FA080808">cast-mask.png</texture>
                    </control>
                    <control type="image">
                        <left>230</left>
                        <top>235</top>
                        <width>54</width>
                        <height>54</height>
                        <texture colordiffuse="FFFFFFFF">circle.png</texture>
                        <visible>!String.IsEmpty(ListItem.Property(protected))</visible>
                    </control>
                    <control type="image">
                        <left>242</left>
                        <top>247</top>
                        <width>30</width>
                        <height>30</height>
                        <texture>icon-lock-amber.png</texture>
                        <visible>!String.IsEmpty(ListItem.Property(protected))</visible>
                    </control>
                    <control type="label">
                        <left>0</left>
                        <top>279</top>
                        <width>300</width>
                        <height>60</height>
                        <font>font_aura_name_bold</font>
                        <align>center</align>
                        <textcolor>FFFFFFFF</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                </focusedlayout>
            </control>
        </control>
    </controls>
</window>
