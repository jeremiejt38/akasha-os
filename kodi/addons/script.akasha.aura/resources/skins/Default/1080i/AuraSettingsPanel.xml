<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1202">
    <!-- The settings list (100) is populated from Python, so it is
         empty when Kodi resolves the default control. A 1px invisible
         pass-through button keeps the boot focus warning quiet; its
         edges all lead back to the real list. -->
    <defaultcontrol>90</defaultcontrol>
    <zorder>2</zorder>
    <controls>
        <control type="button" id="90">
            <left>0</left>
            <top>0</top>
            <width>1</width>
            <height>1</height>
            <texturenofocus>-</texturenofocus>
            <texturefocus>-</texturefocus>
            <onup>100</onup>
            <onleft>100</onleft>
            <onright>100</onright>
            <ondown>100</ondown>
        </control>
        <!-- Dim overlay over whatever is behind (Aura or native Home). -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="CC1A1310">white.png</texture>
        </control>

        <!-- Panel itself: slides in from the right, Android TV-style. -->
        <control type="group">
            <left>330</left>
            <top>0</top>
            <animation effect="slide" start="1590,0" end="0,0" time="220" tween="quadratic" easing="out" condition="true">WindowOpen</animation>
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>1590</width>
                <height>1080</height>
                <texture colordiffuse="FF1A1310">white.png</texture>
            </control>

            <control type="label" id="10">
                <left>60</left>
                <top>48</top>
                <width>1470</width>
                <height>50</height>
                <font>font16</font>
                <label>$ADDON[script.akasha.aura 33019]</label>
                <textcolor>FFFFFFFF</textcolor>
            </control>
            <control type="label" id="11">
                <left>60</left>
                <top>102</top>
                <width>1470</width>
                <height>30</height>
                <font>font11</font>
                <label>Akasha OS</label>
                <textcolor>77FFFFFF</textcolor>
            </control>

            <!-- Left: the current view (categories / settings / radios).
                 Row = title + value subtitle + trailing widget. -->
            <control type="list" id="100">
                <left>40</left>
                <top>160</top>
                <width>900</width>
                <height>880</height>
                <itemlayout width="900" height="76">
                    <control type="label">
                        <left>30</left>
                        <top>0</top>
                        <width>640</width>
                        <height>76</height>
                        <aligny>center</aligny>
                        <font>font12</font>
                        <label>$INFO[ListItem.Label]</label>
                        <textcolor>CCFFFFFF</textcolor>
                    </control>
                    <control type="label">
                        <left>680</left>
                        <top>0</top>
                        <width>190</width>
                        <height>76</height>
                        <align>right</align>
                        <aligny>center</aligny>
                        <font>font11</font>
                        <label>$INFO[ListItem.Label2]</label>
                        <textcolor>88FFFFFF</textcolor>
                    </control>
                    <!-- bool switch: small pill, dim when off -->
                    <control type="image">
                        <left>856</left>
                        <top>26</top>
                        <width>28</width>
                        <height>24</height>
                        <texture colordiffuse="FF3D2B26" border="12">rounded-solid.png</texture>
                        <visible>String.IsEqual(ListItem.Property(switch),off)</visible>
                    </control>
                    <control type="image">
                        <left>856</left>
                        <top>26</top>
                        <width>28</width>
                        <height>24</height>
                        <texture colordiffuse="FFFF8C6C" border="12">rounded-solid.png</texture>
                        <visible>String.IsEqual(ListItem.Property(switch),on)</visible>
                    </control>
                    <!-- radio: filled circle when checked -->
                    <control type="image">
                        <left>860</left>
                        <top>28</top>
                        <width>20</width>
                        <height>20</height>
                        <texture colordiffuse="FFFF8C6C" border="10">rounded-solid.png</texture>
                        <visible>String.IsEqual(ListItem.Property(checked),true)</visible>
                    </control>
                </itemlayout>
                <focusedlayout width="900" height="76">
                    <control type="image">
                        <left>10</left>
                        <top>2</top>
                        <width>880</width>
                        <height>72</height>
                        <texture colordiffuse="FFFF8C6C" border="16">rounded-solid.png</texture>
                    </control>
                    <control type="label">
                        <left>30</left>
                        <top>0</top>
                        <width>640</width>
                        <height>76</height>
                        <aligny>center</aligny>
                        <font>font12</font>
                        <label>$INFO[ListItem.Label]</label>
                        <textcolor>FFFFFFFF</textcolor>
                    </control>
                    <control type="label">
                        <left>680</left>
                        <top>0</top>
                        <width>190</width>
                        <height>76</height>
                        <align>right</align>
                        <aligny>center</aligny>
                        <font>font11</font>
                        <label>$INFO[ListItem.Label2]</label>
                        <textcolor>CCFFFFFF</textcolor>
                    </control>
                    <control type="image">
                        <left>856</left>
                        <top>26</top>
                        <width>28</width>
                        <height>24</height>
                        <texture colordiffuse="FF3D2B26" border="12">rounded-solid.png</texture>
                        <visible>String.IsEqual(ListItem.Property(switch),off)</visible>
                    </control>
                    <control type="image">
                        <left>856</left>
                        <top>26</top>
                        <width>28</width>
                        <height>24</height>
                        <texture colordiffuse="FFFFFFFF" border="12">rounded-solid.png</texture>
                        <visible>String.IsEqual(ListItem.Property(switch),on)</visible>
                    </control>
                    <control type="image">
                        <left>860</left>
                        <top>28</top>
                        <width>20</width>
                        <height>20</height>
                        <texture colordiffuse="FFFFFFFF" border="10">rounded-solid.png</texture>
                        <visible>String.IsEqual(ListItem.Property(checked),true)</visible>
                    </control>
                </focusedlayout>
            </control>

            <!-- Divider. -->
            <control type="image">
                <left>950</left>
                <top>160</top>
                <width>2</width>
                <height>880</height>
                <texture colordiffuse="33FFFFFF">white.png</texture>
            </control>

            <!-- Right: contextual help for the focused row (Android TV's
                 right pane). -->
            <control type="label" id="20">
                <left>990</left>
                <top>700</top>
                <width>540</width>
                <height>340</height>
                <font>font11</font>
                <aligny>top</aligny>
                <wrapmultiline>true</wrapmultiline>
                <textcolor>88FFFFFF</textcolor>
                <label></label>
            </control>
        </control>
    </controls>
</window>
