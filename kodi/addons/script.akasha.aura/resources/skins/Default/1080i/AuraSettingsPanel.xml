<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1202">
    <defaultcontrol>100</defaultcontrol>
    <zorder>2</zorder>
    <controls>
        <!-- Dim overlay over whatever is behind (Aura or native Home),
             "recouvre le reste de l'affichage" per plan a5a87f03 section 1. -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="CC10131A">white.png</texture>
        </control>

        <!-- Panel itself: slides in from the right, covers most (not all)
             of the screen width, "overlay plein ecran ou quasi". -->
        <control type="group">
            <left>420</left>
            <top>0</top>
            <animation effect="slide" start="1500,0" end="0,0" time="220" tween="quadratic" easing="out" condition="true">WindowOpen</animation>
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>1500</width>
                <height>1080</height>
                <texture colordiffuse="FF10131A">white.png</texture>
            </control>

            <control type="label" id="10">
                <left>60</left>
                <top>50</top>
                <width>1380</width>
                <height>50</height>
                <font>font16</font>
                <label>Parametres</label>
                <textcolor>FFFFFFFF</textcolor>
            </control>
            <control type="label">
                <left>60</left>
                <top>100</top>
                <width>1380</width>
                <height>30</height>
                <font>font11</font>
                <label>Akasha OS</label>
                <textcolor>77FFFFFF</textcolor>
            </control>

            <!-- Left column: categories. -->
            <control type="list" id="100">
                <left>40</left>
                <top>160</top>
                <width>480</width>
                <height>880</height>
                <onright>200</onright>
                <itemlayout width="480" height="64">
                    <control type="label">
                        <left>30</left>
                        <top>0</top>
                        <width>430</width>
                        <height>64</height>
                        <aligny>center</aligny>
                        <font>font12</font>
                        <label>$INFO[ListItem.Label]</label>
                        <textcolor>CCFFFFFF</textcolor>
                    </control>
                </itemlayout>
                <focusedlayout width="480" height="64">
                    <control type="image">
                        <left>10</left>
                        <top>2</top>
                        <width>460</width>
                        <height>60</height>
                        <texture colordiffuse="FF262B3D" border="16">rounded-solid.png</texture>
                    </control>
                    <control type="image">
                        <left>10</left>
                        <top>2</top>
                        <width>460</width>
                        <height>60</height>
                        <texture colordiffuse="FF6C8CFF" border="16">rounded-solid.png</texture>
                        <visible>Control.HasFocus(100)</visible>
                    </control>
                    <control type="label">
                        <left>30</left>
                        <top>0</top>
                        <width>430</width>
                        <height>64</height>
                        <aligny>center</aligny>
                        <font>font12</font>
                        <label>$INFO[ListItem.Label]</label>
                        <textcolor>FFFFFFFF</textcolor>
                    </control>
                </focusedlayout>
            </control>

            <!-- Divider. -->
            <control type="image">
                <left>530</left>
                <top>160</top>
                <width>2</width>
                <height>880</height>
                <texture colordiffuse="33FFFFFF">white.png</texture>
            </control>

            <!-- Right column: curated actions for the selected category. -->
            <control type="list" id="200">
                <left>570</left>
                <top>160</top>
                <width>880</width>
                <height>880</height>
                <onleft>100</onleft>
                <itemlayout width="880" height="70">
                    <control type="label">
                        <left>10</left>
                        <top>0</top>
                        <width>860</width>
                        <height>70</height>
                        <aligny>center</aligny>
                        <font>font12</font>
                        <label>$INFO[ListItem.Label]</label>
                        <textcolor>CCFFFFFF</textcolor>
                        <wrapmultiline>true</wrapmultiline>
                    </control>
                </itemlayout>
                <focusedlayout width="880" height="70">
                    <control type="image">
                        <left>0</left>
                        <top>2</top>
                        <width>880</width>
                        <height>66</height>
                        <texture colordiffuse="FF262B3D" border="16">rounded-solid.png</texture>
                    </control>
                    <control type="image">
                        <left>0</left>
                        <top>2</top>
                        <width>880</width>
                        <height>66</height>
                        <texture colordiffuse="FF6C8CFF" border="16">rounded-solid.png</texture>
                        <visible>Control.HasFocus(200)</visible>
                    </control>
                    <control type="label">
                        <left>10</left>
                        <top>0</top>
                        <width>860</width>
                        <height>70</height>
                        <aligny>center</aligny>
                        <font>font12</font>
                        <label>$INFO[ListItem.Label]</label>
                        <textcolor>FFFFFFFF</textcolor>
                        <wrapmultiline>true</wrapmultiline>
                    </control>
                </focusedlayout>
            </control>
        </control>
    </controls>
</window>
