<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1193">
    <defaultcontrol>9000</defaultcontrol>
    <controls>
        <!-- Full-screen dim -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="AA000000">white.png</texture>
            <animation effect="fade" start="0" end="100" time="250">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="250">WindowClose</animation>
        </control>

        <!-- Main centered container -->
        <control type="group">
            <centerleft>960</centerleft>
            <centertop>540</centertop>
            <width>640</width>
            <height>600</height>
            <animation effect="zoom" start="95" end="100" center="auto" time="250" tween="sine">WindowOpen</animation>
            <animation effect="zoom" start="100" end="95" center="auto" time="250" tween="sine">WindowClose</animation>
            <animation effect="fade" start="0" end="100" time="250">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="250">WindowClose</animation>

            <!-- Preset 0 : Akasha / Xbox style -->
            <control type="group">
                <visible>String.IsEqual(Window.Property(AkashaGuidePreset),0)</visible>
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>640</width>
                    <height>560</height>
                    <texture colordiffuse="EE1A1A2E">white.png</texture>
                </control>
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>640</width>
                    <height>6</height>
                    <texture colordiffuse="FF6C8CFF">white.png</texture>
                </control>
            </control>

            <!-- Preset 1 : Compact context menu style -->
            <control type="group">
                <visible>String.IsEqual(Window.Property(AkashaGuidePreset),1)</visible>
                <control type="image">
                    <left>60</left>
                    <top>90</top>
                    <width>520</width>
                    <height>420</height>
                    <texture colordiffuse="F2191919">white.png</texture>
                </control>
                <control type="image">
                    <left>60</left>
                    <top>90</top>
                    <width>520</width>
                    <height>3</height>
                    <texture colordiffuse="FF00D2FF">white.png</texture>
                </control>
            </control>

            <!-- Preset 2 : Classic select list style -->
            <control type="group">
                <visible>String.IsEqual(Window.Property(AkashaGuidePreset),2)</visible>
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>640</width>
                    <height>600</height>
                    <texture colordiffuse="F2101010">white.png</texture>
                </control>
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>640</width>
                    <height>50</height>
                    <texture colordiffuse="FF3A5FCD">white.png</texture>
                </control>
            </control>

            <!-- Shared menu list -->
            <control type="list" id="9000">
                <left>60</left>
                <top>110</top>
                <width>520</width>
                <height>430</height>
                <onup>9000</onup>
                <ondown>9000</ondown>
                <pagecontrol>-</pagecontrol>
                <itemlayout width="520" height="60">
                    <control type="label">
                        <left>20</left>
                        <top>0</top>
                        <width>480</width>
                        <height>60</height>
                        <font>font12</font>
                        <label>$INFO[ListItem.Label]</label>
                        <textcolor>BBFFFFFF</textcolor>
                        <aligny>center</aligny>
                    </control>
                </itemlayout>
                <focusedlayout width="520" height="60">
                    <control type="image">
                        <width>520</width>
                        <height>60</height>
                        <texture colordiffuse="FF6C8CFF">white.png</texture>
                    </control>
                    <control type="label">
                        <left>20</left>
                        <top>0</top>
                        <width>480</width>
                        <height>60</height>
                        <font>font12</font>
                        <label>$INFO[ListItem.Label]</label>
                        <textcolor>FFFFFFFF</textcolor>
                        <aligny>center</aligny>
                    </control>
                </focusedlayout>
            </control>

            <!-- Preset 0 title -->
            <control type="label">
                <visible>String.IsEqual(Window.Property(AkashaGuidePreset),0)</visible>
                <left>40</left>
                <top>35</top>
                <width>560</width>
                <height>50</height>
                <font>font14</font>
                <label>Akasha Guide</label>
                <align>center</align>
                <textcolor>FFFFFFFF</textcolor>
            </control>

            <!-- Preset 2 title -->
            <control type="label">
                <visible>String.IsEqual(Window.Property(AkashaGuidePreset),2)</visible>
                <left>40</left>
                <top>10</top>
                <width>560</width>
                <height>30</height>
                <font>font12</font>
                <label>Menu rapide</label>
                <align>left</align>
                <textcolor>FFFFFFFF</textcolor>
            </control>

            <!-- Preset 2 cancel button -->
            <control type="button" id="9099">
                <visible>String.IsEqual(Window.Property(AkashaGuidePreset),2)</visible>
                <left>460</left>
                <top>545</top>
                <width>160</width>
                <height>45</height>
                <font>font10</font>
                <label>Annuler</label>
                <align>center</align>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FFFFFFFF</focusedcolor>
                <texturefocus colordiffuse="FF5A5A5A">white.png</texturefocus>
                <texturenofocus colordiffuse="FF333333">white.png</texturenofocus>
            </control>

            <!-- Bottom hint -->
            <control type="label">
                <left>40</left>
                <top>565</top>
                <width>560</width>
                <height>25</height>
                <font>font10</font>
                <label>← → : changer de style</label>
                <align>center</align>
                <textcolor>77FFFFFF</textcolor>
            </control>
        </control>
    </controls>
</window>
