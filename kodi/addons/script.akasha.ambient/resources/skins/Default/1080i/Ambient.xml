<?xml version="1.0" encoding="UTF-8"?>
<window type="window">
    <!-- Don't clear the background to black: the multiimage or videowindow
         provides the ambient background, and a black clear would paint over
         a windowed video player on some Kodi builds. -->
    <backgroundcolor>0</backgroundcolor>
    <!-- Keep an invisible focused control so the window reliably receives
         actions (Back, OK, etc.) even when only non-focusable controls such
         as labels and the videowindow are visible. -->
    <defaultcontrol always="true">9000</defaultcontrol>
    <controls>
        <!-- Invisible focused control used by <defaultcontrol>. -->
        <control type="button" id="9000">
            <left>0</left>
            <top>0</top>
            <width>1</width>
            <height>1</height>
            <texturefocus colordiffuse="00000000">white.png</texturefocus>
            <texturenofocus colordiffuse="00000000">white.png</texturenofocus>
            <onleft>9000</onleft>
            <onright>9000</onright>
            <onup>9000</onup>
            <ondown>9000</ondown>
        </control>

        <!-- Background slideshow: two image slots alternating on
             `ambient.slot`, driven by ambient_window._slideshow_loop. Each
             slot carries its photo path in `ambient.img{slot}` and a Ken
             Burns variant in `ambient.kb{slot}` (see slideshow.py). The
             Visible zoom animation restarts every time a slot fades in, so
             each photo gets its own slow drift — Google TV Ambient Mode
             style — with no timer drift and no snap-back mid-photo (unlike
             looping an animation on a single multiimage control). The
             conditioned Hidden zoom keeps drifting during fade-out so the
             outgoing photo does not jump back to its base transform. -->
        <control type="group" id="9400">
            <animation effect="fade" start="0" end="100" time="1500">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="800">WindowClose</animation>
            <control type="image">
                <visible>String.IsEqual(Window.Property(ambient.slot),0)</visible>
                <left>0</left>
                <top>0</top>
                <width>1920</width>
                <height>1080</height>
                <texture background="true">$INFO[Window.Property(ambient.img0)]</texture>
                <aspectratio aligny="center" alignx="center">scale</aspectratio>
                <animation effect="fade" start="0" end="100" time="3000" tween="sine" easing="inout">Visible</animation>
                <animation effect="fade" start="100" end="0" time="3000" tween="sine" easing="inout">Hidden</animation>
                <animation effect="zoom" start="100" end="108" center="960,540" time="48000" tween="linear" condition="String.IsEqual(Window.Property(ambient.kb0),1)">Visible</animation>
                <animation effect="zoom" start="108" end="100" center="960,540" time="48000" tween="linear" condition="String.IsEqual(Window.Property(ambient.kb0),2)">Visible</animation>
                <animation effect="zoom" start="100" end="109" center="620,330" time="48000" tween="linear" condition="String.IsEqual(Window.Property(ambient.kb0),3)">Visible</animation>
                <animation effect="zoom" start="100" end="109" center="1300,750" time="48000" tween="linear" condition="String.IsEqual(Window.Property(ambient.kb0),4)">Visible</animation>
                <animation effect="zoom" start="108" end="111" center="960,540" time="3000" tween="linear" condition="String.IsEqual(Window.Property(ambient.kb0),1)">Hidden</animation>
                <animation effect="zoom" start="100" end="97" center="960,540" time="3000" tween="linear" condition="String.IsEqual(Window.Property(ambient.kb0),2)">Hidden</animation>
                <animation effect="zoom" start="109" end="112" center="620,330" time="3000" tween="linear" condition="String.IsEqual(Window.Property(ambient.kb0),3)">Hidden</animation>
                <animation effect="zoom" start="109" end="112" center="1300,750" time="3000" tween="linear" condition="String.IsEqual(Window.Property(ambient.kb0),4)">Hidden</animation>
            </control>
            <control type="image">
                <visible>String.IsEqual(Window.Property(ambient.slot),1)</visible>
                <left>0</left>
                <top>0</top>
                <width>1920</width>
                <height>1080</height>
                <texture background="true">$INFO[Window.Property(ambient.img1)]</texture>
                <aspectratio aligny="center" alignx="center">scale</aspectratio>
                <animation effect="fade" start="0" end="100" time="3000" tween="sine" easing="inout">Visible</animation>
                <animation effect="fade" start="100" end="0" time="3000" tween="sine" easing="inout">Hidden</animation>
                <animation effect="zoom" start="100" end="108" center="960,540" time="48000" tween="linear" condition="String.IsEqual(Window.Property(ambient.kb1),1)">Visible</animation>
                <animation effect="zoom" start="108" end="100" center="960,540" time="48000" tween="linear" condition="String.IsEqual(Window.Property(ambient.kb1),2)">Visible</animation>
                <animation effect="zoom" start="100" end="109" center="620,330" time="48000" tween="linear" condition="String.IsEqual(Window.Property(ambient.kb1),3)">Visible</animation>
                <animation effect="zoom" start="100" end="109" center="1300,750" time="48000" tween="linear" condition="String.IsEqual(Window.Property(ambient.kb1),4)">Visible</animation>
                <animation effect="zoom" start="108" end="111" center="960,540" time="3000" tween="linear" condition="String.IsEqual(Window.Property(ambient.kb1),1)">Hidden</animation>
                <animation effect="zoom" start="100" end="97" center="960,540" time="3000" tween="linear" condition="String.IsEqual(Window.Property(ambient.kb1),2)">Hidden</animation>
                <animation effect="zoom" start="109" end="112" center="620,330" time="3000" tween="linear" condition="String.IsEqual(Window.Property(ambient.kb1),3)">Hidden</animation>
                <animation effect="zoom" start="109" end="112" center="1300,750" time="3000" tween="linear" condition="String.IsEqual(Window.Property(ambient.kb1),4)">Hidden</animation>
            </control>
        </control>

        <!-- Progressive dimming overlay (energy.dim_overlay_color). No local
             backlight to control on a TV driven over HDMI, so this simulates
             "brightness reduction" ahead of the CEC sleep handoff. -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="$INFO[Window.Property(dim_color)]">white.png</texture>
        </control>

        <!-- Clock + weather widget, cycled through 4 corner presets every
             10 minutes (energy.widget_preset_for_elapsed) as a simple anti
             burn-in measure, mirroring the preset pattern already used in
             script.akasha.guide/.../Guide.xml. The widget content itself is
             duplicated per corner (rather than a shared <include>) to avoid
             any ambiguity around include resolution inside a screensaver
             window skin. -->
        <control type="group" id="9500">
            <!-- Preset 0: top-left -->
            <control type="group">
                <visible>String.IsEqual(Window.Property(widget_preset),0)</visible>
                <left>60</left>
                <top>60</top>
                <width>360</width>
                <height>132</height>
                <animation effect="fade" start="0" end="100" time="600">WindowOpen</animation>
                <control type="image">
                    <left>-60</left>
                    <top>-60</top>
                    <width>480</width>
                    <height>210</height>
                    <texture colordiffuse="FF000000">scrim-top.png</texture>
                    <aspectratio>stretch</aspectratio>
                </control>
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>360</width>
                    <height>70</height>
                    <font>font14</font>
                    <label>$INFO[System.Time]</label>
                    <textcolor>FFFFFFFF</textcolor>
                    <shadowcolor>AA000000</shadowcolor>
                </control>
                <control type="label">
                    <left>0</left>
                    <top>72</top>
                    <width>360</width>
                    <height>30</height>
                    <font>font12</font>
                    <label>$INFO[System.Date]</label>
                    <textcolor>DDFFFFFF</textcolor>
                    <shadowcolor>AA000000</shadowcolor>
                </control>
                <control type="label">
                    <visible>!String.IsEmpty(Window.Property(weather_available))</visible>
                    <left>0</left>
                    <top>104</top>
                    <width>360</width>
                    <height>28</height>
                    <font>font12</font>
                    <label>$INFO[Window.Property(weather_temp)] - $INFO[Window.Property(weather_condition)]</label>
                    <textcolor>CCFFFFFF</textcolor>
                    <shadowcolor>AA000000</shadowcolor>
                </control>
            </control>

            <!-- Preset 1: top-right -->
            <control type="group">
                <visible>String.IsEqual(Window.Property(widget_preset),1)</visible>
                <left>1500</left>
                <top>60</top>
                <width>360</width>
                <height>132</height>
                <animation effect="fade" start="0" end="100" time="600">WindowOpen</animation>
                <control type="image">
                    <left>-60</left>
                    <top>-60</top>
                    <width>480</width>
                    <height>210</height>
                    <texture colordiffuse="FF000000">scrim-top.png</texture>
                    <aspectratio>stretch</aspectratio>
                </control>
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>360</width>
                    <height>70</height>
                    <font>font14</font>
                    <label>$INFO[System.Time]</label>
                    <align>right</align>
                    <textcolor>FFFFFFFF</textcolor>
                    <shadowcolor>AA000000</shadowcolor>
                </control>
                <control type="label">
                    <left>0</left>
                    <top>72</top>
                    <width>360</width>
                    <height>30</height>
                    <font>font12</font>
                    <label>$INFO[System.Date]</label>
                    <align>right</align>
                    <textcolor>DDFFFFFF</textcolor>
                    <shadowcolor>AA000000</shadowcolor>
                </control>
                <control type="label">
                    <visible>!String.IsEmpty(Window.Property(weather_available))</visible>
                    <left>0</left>
                    <top>104</top>
                    <width>360</width>
                    <height>28</height>
                    <font>font12</font>
                    <label>$INFO[Window.Property(weather_temp)] - $INFO[Window.Property(weather_condition)]</label>
                    <align>right</align>
                    <textcolor>CCFFFFFF</textcolor>
                    <shadowcolor>AA000000</shadowcolor>
                </control>
            </control>

            <!-- Preset 2: bottom-right -->
            <control type="group">
                <visible>String.IsEqual(Window.Property(widget_preset),2)</visible>
                <left>1500</left>
                <top>888</top>
                <width>360</width>
                <height>132</height>
                <animation effect="fade" start="0" end="100" time="600">WindowOpen</animation>
                <control type="image">
                    <left>-60</left>
                    <top>-20</top>
                    <width>480</width>
                    <height>212</height>
                    <texture colordiffuse="FF000000">scrim-bottom.png</texture>
                    <aspectratio>stretch</aspectratio>
                </control>
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>360</width>
                    <height>70</height>
                    <font>font14</font>
                    <label>$INFO[System.Time]</label>
                    <align>right</align>
                    <textcolor>FFFFFFFF</textcolor>
                    <shadowcolor>AA000000</shadowcolor>
                </control>
                <control type="label">
                    <left>0</left>
                    <top>72</top>
                    <width>360</width>
                    <height>30</height>
                    <font>font12</font>
                    <label>$INFO[System.Date]</label>
                    <align>right</align>
                    <textcolor>DDFFFFFF</textcolor>
                    <shadowcolor>AA000000</shadowcolor>
                </control>
                <control type="label">
                    <visible>!String.IsEmpty(Window.Property(weather_available))</visible>
                    <left>0</left>
                    <top>104</top>
                    <width>360</width>
                    <height>28</height>
                    <font>font12</font>
                    <label>$INFO[Window.Property(weather_temp)] - $INFO[Window.Property(weather_condition)]</label>
                    <align>right</align>
                    <textcolor>CCFFFFFF</textcolor>
                    <shadowcolor>AA000000</shadowcolor>
                </control>
            </control>

            <!-- Preset 3: bottom-left -->
            <control type="group">
                <visible>String.IsEqual(Window.Property(widget_preset),3)</visible>
                <left>60</left>
                <top>888</top>
                <width>360</width>
                <height>132</height>
                <animation effect="fade" start="0" end="100" time="600">WindowOpen</animation>
                <control type="image">
                    <left>-60</left>
                    <top>-20</top>
                    <width>480</width>
                    <height>212</height>
                    <texture colordiffuse="FF000000">scrim-bottom.png</texture>
                    <aspectratio>stretch</aspectratio>
                </control>
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>360</width>
                    <height>70</height>
                    <font>font14</font>
                    <label>$INFO[System.Time]</label>
                    <textcolor>FFFFFFFF</textcolor>
                    <shadowcolor>AA000000</shadowcolor>
                </control>
                <control type="label">
                    <left>0</left>
                    <top>72</top>
                    <width>360</width>
                    <height>30</height>
                    <font>font12</font>
                    <label>$INFO[System.Date]</label>
                    <textcolor>DDFFFFFF</textcolor>
                    <shadowcolor>AA000000</shadowcolor>
                </control>
                <control type="label">
                    <visible>!String.IsEmpty(Window.Property(weather_available))</visible>
                    <left>0</left>
                    <top>104</top>
                    <width>360</width>
                    <height>28</height>
                    <font>font12</font>
                    <label>$INFO[Window.Property(weather_temp)] - $INFO[Window.Property(weather_condition)]</label>
                    <textcolor>CCFFFFFF</textcolor>
                    <shadowcolor>AA000000</shadowcolor>
                </control>
            </control>
        </control>
    </controls>
</window>
