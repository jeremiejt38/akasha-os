<?xml version="1.0" encoding="UTF-8"?>
<!-- Akasha OS keymap for the Amazon Fire TV Bluetooth remote ("AR" / "AR Keyboard").

The remote exposes itself as a Bluetooth HID keyboard. This keymap binds the
standard media/navigation keys to Kodi actions so the remote works out of the
box with Akasha Aura and the rest of the interface.
-->
<keymap>
  <global>
    <keyboard>
      <!-- The Fire TV remote's Home button sends the HID 'browser_home' key
           (scancode 0xac), not the generic 'home' key. Long-press is detected
           by Kodi's own mod="longpress" keymap modifier (~250ms hold). -->
      <browser_home>RunScript(script.akasha.aura)</browser_home>
      <browser_home mod="longpress">RunScript(script.akasha.guide)</browser_home>
      <menu>ContextMenu</menu>
      <escape>Back</escape>
      <back>Back</back>
      <play>PlayPause</play>
      <playpause>PlayPause</playpause>
      <stop>Stop</stop>
      <rewind>Rewind</rewind>
      <fastforward>FastForward</fastforward>
      <!-- Volume binds directly to the native actions: the remote repeats
           at ~33ms while held and each RunScript spawns a fresh Python
           interpreter (~150ms on the Pi), so the scripted router piled up
           presses and lagged badly - and its akasha-mode handler was
           broken anyway (VolumeUp is an action name, not a builtin). The
           volume_mode setting (CEC routing) is retained in the addon for
           the documented scripted path; see docs/remote/decisions.md. -->
      <volume_up>VolumeUp</volume_up>
      <volume_down>VolumeDown</volume_down>
      <volume_mute>Mute</volume_mute>
      <!-- Fire TV remote power button: trigger Akasha sleep (CEC standby + wake-on-input). -->
      <power>RunScript(service.akasha.remote,power)</power>
      <sleep>RunScript(service.akasha.remote,power)</sleep>
      <!-- Gear-wheel "Settings" button (dd440e2e section 9). Unnamed
           key, confirmed live via debug logging: "HandleKey: 0 (0xf200,
           obc-61697) pressed". The id below is the decimal value of the
           0xf200 hex keycode itself (61952), not the "obc-61697" figure
           also printed on that log line (that one is a separate
           universal-remote identifier, unrelated to this keyboard
           mapping syntax); confirmed against a matching real-world
           report (a similar remote with the exact same log signature,
           OSMC forum). Distinct from the play/playpause keys above
           (their own key id is 0xf0bd), which stay untouched: only this
           specific numeric id is remapped, not the whole PlayPause
           action, so real media play/pause elsewhere is unaffected. -->
      <key id="61952">RunScript(script.akasha.aura,opensettings)</key>
    </keyboard>
  </global>
  <FullscreenVideo>
    <keyboard>
      <back>Stop</back>
      <escape>Stop</escape>
      <!-- Without this, the gear-wheel key (0xf200/obc-61697) resolves to
           the built-in media-stop appcommand in fullscreen and kills the
           video. Routing it to the same opensettings entry keeps one
           meaning everywhere, and Aura's playback guard makes it a
           no-op while a video plays. -->
      <key id="61952">RunScript(script.akasha.aura,opensettings)</key>
      <!-- A long Home press falls through to the GLOBAL binding and
           launches script.akasha.guide over the video; its "Accueil"/power
           entries then tear down playback - and a stray Yes/No dialog can
           even exit Kodi entirely (observed live: guide opened at
           fullscreen, presses wandered, Kodi quit cleanly). In fullscreen
           the sensible "menu" surface is the player OSD itself. -->
      <browser_home mod="longpress">ActivateWindow(videoosd)</browser_home>
      <!-- Plex Android TV transport: arrows seek fixed offsets instead of
           Kodi's StepBack/StepForward (which use variable seek-steps and
           historically hid the real "video froze" cause: every arrow press
           re-opened a new HTTP range request against the remote stream and
           a stalled range read killed playback). -->
      <left>Seek(-10)</left>
      <right>Seek(30)</right>
      <!-- Up/Down show the player controls like the Plex TV remote. They
           also kill the default ChapterOrBigStep* jumps: Plex chapters
           aren't exposed to Kodi over plain HTTP playback anyway, so the
           default binding was a silent random jump. -->
      <up>OSD</up>
      <down>OSD</down>
      <menu>OSD</menu>
      <!-- OK toggles pause directly when the OSD bar isn't open (Plex does
           the same: center button pauses). Once the VideoOSD window is up
           its own window context handles select on the focused control. -->
      <return>PlayPause</return>
      <enter>PlayPause</enter>
    </keyboard>
  </FullscreenVideo>

  <!-- When Akasha Aura (window id 1194) is active, the gear-wheel button
       sends the "Menu" action directly to AuraWindow.onAction(), which opens
       the unified settings panel. When Aura is not open, the <global> entry
       above falls back to RunScript(script.akasha.aura, opensettings).
       NOTE: the tag must be exactly "window" + the numeric id (no "Id"
       infix), per CWindowTranslator::TranslateWindow, which only
       recognizes that exact "window12345" form for custom/addon window
       ids (see xbmc/input/WindowTranslator.cpp). An earlier
       "windowId1194" typo here silently failed to parse ("Window
       Translator: Can't find window windowId1194" logged on every
       keymap load), which meant this override never actually applied;
       the gear-wheel button fell back to the global RunScript entry the
       whole time regardless (itself fixed separately, see the "Other."
       prefix bug in docs/remote/decisions.md), so this had no
       behavioural impact, just log noise. -->
  <window1194>
    <keyboard>
      <key id="61952">Menu</key>
    </keyboard>
  </window1194>
</keymap>
