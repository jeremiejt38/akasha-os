<?xml version="1.0" encoding="UTF-8"?>
<!-- Akasha OS keymap for the Amazon Fire TV Bluetooth remote ("AR" / "AR Keyboard").

The remote exposes itself as a Bluetooth HID keyboard. This keymap binds the
standard media/navigation keys to Kodi actions so the remote works out of the
box with Akasha Aura and the rest of the interface.
-->
<keymap>
  <global>
    <keyboard>
      <!-- The Fire TV remote's Home button sends the HID 'browser_home' key
           (scancode 0xac), not the generic 'home' key. Long-press is detected
           by Kodi's own mod="longpress" keymap modifier (~250ms hold). -->
      <browser_home>RunScript(script.akasha.aura)</browser_home>
      <browser_home mod="longpress">RunScript(script.akasha.guide)</browser_home>
      <menu>ContextMenu</menu>
      <escape>Back</escape>
      <back>Back</back>
      <play>PlayPause</play>
      <playpause>PlayPause</playpause>
      <stop>Stop</stop>
      <rewind>Rewind</rewind>
      <fastforward>FastForward</fastforward>
      <volumeup>RunScript(service.akasha.remote,volume_up)</volumeup>
      <volumedown>RunScript(service.akasha.remote,volume_down)</volumedown>
      <mute>RunScript(service.akasha.remote,mute)</mute>
      <!-- Fire TV remote power button: trigger Akasha sleep (CEC standby + wake-on-input). -->
      <power>RunScript(service.akasha.remote,power)</power>
      <sleep>RunScript(service.akasha.remote,power)</sleep>
    </keyboard>
  </global>
  <FullscreenVideo>
    <keyboard>
      <back>Stop</back>
      <escape>Stop</escape>
    </keyboard>
  </FullscreenVideo>
</keymap>
