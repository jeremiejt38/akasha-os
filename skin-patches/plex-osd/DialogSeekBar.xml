<?xml version="1.0" encoding="UTF-8"?>
<!-- Akasha Plex-style DialogSeekBar (replaces Arctic Horizon 2's).
     Passive twin of the plex-osd VideoOSD: identical geometry so pause,
     seek and ShowInfo surface the same Plex-style chrome instead of
     Arctic's giant-title overlay. Hidden while the interactive VideoOSD
     dialog is open so the two never double-render. -->
<window>
    <zorder>0</zorder>
    <visible>!Player.HasGame</visible>
    <visible>!Window.IsActive(videoosd)</visible>
    <visible>Window.IsActive(VideoFullScreen.xml)</visible>
    <visible>Player.Caching | Player.ShowInfo | Player.Seeking | Player.DisplayAfterSeek | [Player.Paused + [!System.IdleTime(3)]] | Player.Forwarding | Player.Rewinding | !String.IsEmpty(Player.SeekNumeric)</visible>
    <controls>
        <!-- Scrim gradients for readability -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>220</height>
            <texture>akasha-osd-scrim-top.png</texture>
        </control>
        <control type="image">
            <left>0</left>
            <top>860</top>
            <width>1920</width>
            <height>220</height>
            <texture>akasha-osd-scrim-bottom.png</texture>
        </control>

        <!-- Title block, top-left (same slot as VideoOSD) -->
        <control type="label">
            <left>73</left>
            <top>66</top>
            <width>1400</width>
            <height>48</height>
            <font>font_aura_head_bold</font>
            <label>$INFO[VideoPlayer.Title]</label>
            <textcolor>FFFFFFFF</textcolor>
        </control>
        <control type="grouplist">
            <left>73</left>
            <top>108</top>
            <width>1600</width>
            <height>34</height>
            <orientation>horizontal</orientation>
            <itemgap>10</itemgap>
            <aligny>center</aligny>
            <visible>VideoPlayer.Content(episodes) + !Integer.IsGreater(Player.Duration(h),0)</visible>
            <control type="label">
                <width>auto</width>
                <height>34</height>
                <font>font_aura_midi</font>
                <aligny>center</aligny>
                <label>$INFO[VideoPlayer.Season,S] • E$INFO[VideoPlayer.Episode] • $INFO[VideoPlayer.TvShowTitle] • $INFO[VideoPlayer.Duration(mins)] $ADDON[script.akasha.aura 33585]</label>
                <textcolor>DDFFFFFF</textcolor>
            </control>
            <control type="image">
                <width>40</width>
                <height>24</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[VideoPlayer.VideoResolution,osd-tag-,.png]</texture>
            </control>
        </control>
        <control type="grouplist">
            <left>73</left>
            <top>108</top>
            <width>1600</width>
            <height>34</height>
            <orientation>horizontal</orientation>
            <itemgap>10</itemgap>
            <aligny>center</aligny>
            <visible>VideoPlayer.Content(episodes) + Integer.IsGreater(Player.Duration(h),0)</visible>
            <control type="label">
                <width>auto</width>
                <height>34</height>
                <font>font_aura_midi</font>
                <aligny>center</aligny>
                <label>$INFO[VideoPlayer.Season,S] • E$INFO[VideoPlayer.Episode] • $INFO[VideoPlayer.TvShowTitle] • $INFO[VideoPlayer.Duration(h)] h $INFO[VideoPlayer.Duration(mm)] min</label>
                <textcolor>DDFFFFFF</textcolor>
            </control>
            <control type="image">
                <width>40</width>
                <height>24</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[VideoPlayer.VideoResolution,osd-tag-,.png]</texture>
            </control>
        </control>
        <control type="grouplist">
            <left>73</left>
            <top>108</top>
            <width>1600</width>
            <height>34</height>
            <orientation>horizontal</orientation>
            <itemgap>10</itemgap>
            <aligny>center</aligny>
            <visible>VideoPlayer.Content(movies) + !Integer.IsGreater(Player.Duration(h),0)</visible>
            <control type="label">
                <width>auto</width>
                <height>34</height>
                <font>font_aura_midi</font>
                <aligny>center</aligny>
                <label>$INFO[VideoPlayer.Year] • $INFO[VideoPlayer.Duration(mins)] $ADDON[script.akasha.aura 33585]</label>
                <textcolor>DDFFFFFF</textcolor>
            </control>
            <control type="image">
                <width>40</width>
                <height>24</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[VideoPlayer.VideoResolution,osd-tag-,.png]</texture>
            </control>
        </control>
        <control type="grouplist">
            <left>73</left>
            <top>108</top>
            <width>1600</width>
            <height>34</height>
            <orientation>horizontal</orientation>
            <itemgap>10</itemgap>
            <aligny>center</aligny>
            <visible>VideoPlayer.Content(movies) + Integer.IsGreater(Player.Duration(h),0)</visible>
            <control type="label">
                <width>auto</width>
                <height>34</height>
                <font>font_aura_midi</font>
                <aligny>center</aligny>
                <label>$INFO[VideoPlayer.Year] • $INFO[VideoPlayer.Duration(h)] h $INFO[VideoPlayer.Duration(mm)] min</label>
                <textcolor>DDFFFFFF</textcolor>
            </control>
            <control type="image">
                <width>40</width>
                <height>24</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[VideoPlayer.VideoResolution,osd-tag-,.png]</texture>
            </control>
        </control>
        <control type="grouplist">
            <left>73</left>
            <top>108</top>
            <width>1600</width>
            <height>34</height>
            <orientation>horizontal</orientation>
            <itemgap>10</itemgap>
            <aligny>center</aligny>
            <visible>!VideoPlayer.Content(episodes) + !VideoPlayer.Content(movies) + !Integer.IsGreater(Player.Duration(h),0)</visible>
            <control type="label">
                <width>auto</width>
                <height>34</height>
                <font>font_aura_midi</font>
                <aligny>center</aligny>
                <label>$INFO[VideoPlayer.Duration(mins)] $ADDON[script.akasha.aura 33585]</label>
                <textcolor>DDFFFFFF</textcolor>
            </control>
            <control type="image">
                <width>40</width>
                <height>24</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[VideoPlayer.VideoResolution,osd-tag-,.png]</texture>
            </control>
        </control>
        <control type="grouplist">
            <left>73</left>
            <top>108</top>
            <width>1600</width>
            <height>34</height>
            <orientation>horizontal</orientation>
            <itemgap>10</itemgap>
            <aligny>center</aligny>
            <visible>!VideoPlayer.Content(episodes) + !VideoPlayer.Content(movies) + Integer.IsGreater(Player.Duration(h),0)</visible>
            <control type="label">
                <width>auto</width>
                <height>34</height>
                <font>font_aura_midi</font>
                <aligny>center</aligny>
                <label>$INFO[VideoPlayer.Duration(h)] h $INFO[VideoPlayer.Duration(mm)] min</label>
                <textcolor>DDFFFFFF</textcolor>
            </control>
            <control type="image">
                <width>40</width>
                <height>24</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[VideoPlayer.VideoResolution,osd-tag-,.png]</texture>
            </control>
        </control>

        <!-- Clock, top-right -->
        <control type="label">
            <left>1640</left>
            <top>53</top>
            <width>164</width>
            <height>40</height>
            <font>font_aura_mini</font>
            <align>right</align>
            <aligny>center</aligny>
            <label>$INFO[System.Time(h:mm)]</label>
            <textcolor>FFFFFFFF</textcolor>
        </control>
        <control type="label">
            <left>1807</left>
            <top>53</top>
            <width>44</width>
            <height>40</height>
            <aligny>center</aligny>
            <font>font_aura_mini</font>
            <label>AM</label>
            <textcolor>FFFFFFFF</textcolor>
            <visible>!Integer.IsGreater(System.Time(hh),11)</visible>
        </control>
        <control type="label">
            <left>1807</left>
            <top>53</top>
            <width>44</width>
            <height>40</height>
            <aligny>center</aligny>
            <font>font_aura_mini</font>
            <label>PM</label>
            <textcolor>FFFFFFFF</textcolor>
            <visible>Integer.IsGreater(System.Time(hh),11)</visible>
        </control>

        <!-- Bottom bar: passive play/pause glyph, elapsed, slim progress,
             remaining; same coordinates as VideoOSD so the two states
             look continuous. -->
        <control type="image">
            <left>60</left>
            <top>946</top>
            <width>64</width>
            <height>64</height>
            <aspectratio>keep</aspectratio>
            <texture>osd/pause.png</texture>
            <visible>!Player.Paused</visible>
        </control>
        <control type="image">
            <left>56</left>
            <top>947</top>
            <width>64</width>
            <height>64</height>
            <aspectratio>keep</aspectratio>
            <texture>osd/play.png</texture>
            <visible>Player.Paused</visible>
        </control>
        <control type="label">
            <left>148</left>
            <top>954</top>
            <width>110</width>
            <height>40</height>
            <font>font_aura_clock</font>
            <aligny>center</aligny>
            <label>$INFO[Player.Time(m)]:$INFO[Player.Time(ss)]</label>
            <textcolor>FFFFFFFF</textcolor>
            <visible>!Integer.IsGreater(Player.Duration(h),0)</visible>
        </control>
        <control type="label">
            <left>148</left>
            <top>954</top>
            <width>110</width>
            <height>40</height>
            <font>font_aura_clock</font>
            <aligny>center</aligny>
            <label>$INFO[Player.Time(h:mm:ss)]</label>
            <textcolor>FFFFFFFF</textcolor>
            <visible>Integer.IsGreater(Player.Duration(h),0)</visible>
        </control>
        <control type="progress">
            <left>222</left>
            <top>969</top>
            <width>1500</width>
            <height>12</height>
            <info>Player.Progress</info>
            <texturebg colordiffuse="5EFFFFFF" border="6">progress/progress-bg.png</texturebg>
            <lefttexture colordiffuse="FFE5A00D" border="2">progress/progress-left.png</lefttexture>
            <midtexture colordiffuse="FFE5A00D" border="2">progress/progress-end.png</midtexture>
            <righttexture colordiffuse="FFE5A00D" border="2">progress/progress-right.png</righttexture>
            <overlaytexture></overlaytexture>
        </control>
        <control type="label">
            <left>1638</left>
            <top>954</top>
            <width>204</width>
            <height>40</height>
            <font>font_aura_clock</font>
            <align>right</align>
            <aligny>center</aligny>
            <label>-$INFO[Player.TimeRemaining(m)]:$INFO[Player.TimeRemaining(ss)]</label>
            <textcolor>FFFFFFFF</textcolor>
            <visible>!Integer.IsGreater(Player.Duration(h),0)</visible>
        </control>
        <control type="label">
            <left>1638</left>
            <top>954</top>
            <width>204</width>
            <height>40</height>
            <font>font_aura_clock</font>
            <align>right</align>
            <aligny>center</aligny>
            <label>-$INFO[Player.TimeRemaining(h:mm:ss)]</label>
            <textcolor>FFFFFFFF</textcolor>
            <visible>Integer.IsGreater(Player.Duration(h),0)</visible>
        </control>

        <!-- Dismiss chevron -->
        <control type="image">
            <left>949</left>
            <top>1006</top>
            <width>22</width>
            <height>10</height>
            <texture>osd-chev.png</texture>
        </control>
    </controls>
</window>
