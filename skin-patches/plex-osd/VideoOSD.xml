<?xml version="1.0" encoding="UTF-8"?>
<!-- Akasha Plex-style VideoOSD (replaces Arctic Horizon 2's).
     Mirrors the Android TV OSD measured in docs/plex-parity/reference/lecteur/:
     title + SxEx/show/duration top-left (x73), naked clock top-right,
     slim seek bar bottom (x222-1722, 12px) with the 24px white knob,
     naked play/pause glyph, subtitle and settings circles bottom-right
     (~76px at y862), a thin down chevron opening the chapters/queue
     overlay (AuraOsdQueue). -->
<window>
    <defaultcontrol>9100</defaultcontrol>
    <controls>
        <!-- Scrim gradients for readability -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>220</height>
            <texture>akasha-osd-scrim-top.png</texture>
        </control>
        <control type="image">
            <left>0</left>
            <top>860</top>
            <width>1920</width>
            <height>220</height>
            <texture>akasha-osd-scrim-bottom.png</texture>
        </control>

        <!-- Title block, top-left (Plex: Inter ~36px, caps y73-99) -->
        <control type="label">
            <left>73</left>
            <top>66</top>
            <width>1400</width>
            <height>48</height>
            <font>font_aura_head_bold</font>
            <label>$INFO[VideoPlayer.Title]</label>
            <textcolor>FFFFFFFF</textcolor>
        </control>
        <!-- Meta line + quality tag hugging the text (Plex: caps
             y115-134, tag ~24px trailing ~10px after the last word). -->
        <control type="grouplist">
            <left>73</left>
            <top>108</top>
            <width>1600</width>
            <height>34</height>
            <orientation>horizontal</orientation>
            <itemgap>10</itemgap>
            <aligny>center</aligny>
            <visible>VideoPlayer.Content(episodes) + !Integer.IsGreater(Player.Duration(h),0)</visible>
            <control type="label">
                <width>auto</width>
                <height>34</height>
                <font>font_aura_midi</font>
                <aligny>center</aligny>
                <label>$INFO[VideoPlayer.Season,S] • E$INFO[VideoPlayer.Episode] • $INFO[VideoPlayer.TvShowTitle] • $INFO[VideoPlayer.Duration(mins)] $ADDON[script.akasha.aura 33585]</label>
                <textcolor>DDFFFFFF</textcolor>
            </control>
            <control type="image">
                <width>40</width>
                <height>24</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[VideoPlayer.VideoResolution,osd-tag-,.png]</texture>
            </control>
        </control>
        <control type="grouplist">
            <left>73</left>
            <top>108</top>
            <width>1600</width>
            <height>34</height>
            <orientation>horizontal</orientation>
            <itemgap>10</itemgap>
            <aligny>center</aligny>
            <visible>VideoPlayer.Content(episodes) + Integer.IsGreater(Player.Duration(h),0)</visible>
            <control type="label">
                <width>auto</width>
                <height>34</height>
                <font>font_aura_midi</font>
                <aligny>center</aligny>
                <label>$INFO[VideoPlayer.Season,S] • E$INFO[VideoPlayer.Episode] • $INFO[VideoPlayer.TvShowTitle] • $INFO[VideoPlayer.Duration(h)] h $INFO[VideoPlayer.Duration(mm)] min</label>
                <textcolor>DDFFFFFF</textcolor>
            </control>
            <control type="image">
                <width>40</width>
                <height>24</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[VideoPlayer.VideoResolution,osd-tag-,.png]</texture>
            </control>
        </control>
        <control type="grouplist">
            <left>73</left>
            <top>108</top>
            <width>1600</width>
            <height>34</height>
            <orientation>horizontal</orientation>
            <itemgap>10</itemgap>
            <aligny>center</aligny>
            <visible>VideoPlayer.Content(movies) + !Integer.IsGreater(Player.Duration(h),0)</visible>
            <control type="label">
                <width>auto</width>
                <height>34</height>
                <font>font_aura_midi</font>
                <aligny>center</aligny>
                <label>$INFO[VideoPlayer.Year] • $INFO[VideoPlayer.Duration(mins)] $ADDON[script.akasha.aura 33585]</label>
                <textcolor>DDFFFFFF</textcolor>
            </control>
            <control type="image">
                <width>40</width>
                <height>24</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[VideoPlayer.VideoResolution,osd-tag-,.png]</texture>
            </control>
        </control>
        <control type="grouplist">
            <left>73</left>
            <top>108</top>
            <width>1600</width>
            <height>34</height>
            <orientation>horizontal</orientation>
            <itemgap>10</itemgap>
            <aligny>center</aligny>
            <visible>VideoPlayer.Content(movies) + Integer.IsGreater(Player.Duration(h),0)</visible>
            <control type="label">
                <width>auto</width>
                <height>34</height>
                <font>font_aura_midi</font>
                <aligny>center</aligny>
                <label>$INFO[VideoPlayer.Year] • $INFO[VideoPlayer.Duration(h)] h $INFO[VideoPlayer.Duration(mm)] min</label>
                <textcolor>DDFFFFFF</textcolor>
            </control>
            <control type="image">
                <width>40</width>
                <height>24</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[VideoPlayer.VideoResolution,osd-tag-,.png]</texture>
            </control>
        </control>
        <control type="grouplist">
            <left>73</left>
            <top>108</top>
            <width>1600</width>
            <height>34</height>
            <orientation>horizontal</orientation>
            <itemgap>10</itemgap>
            <aligny>center</aligny>
            <visible>!VideoPlayer.Content(episodes) + !VideoPlayer.Content(movies) + !Integer.IsGreater(Player.Duration(h),0)</visible>
            <control type="label">
                <width>auto</width>
                <height>34</height>
                <font>font_aura_midi</font>
                <aligny>center</aligny>
                <label>$INFO[VideoPlayer.Duration(mins)] $ADDON[script.akasha.aura 33585]</label>
                <textcolor>DDFFFFFF</textcolor>
            </control>
            <control type="image">
                <width>40</width>
                <height>24</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[VideoPlayer.VideoResolution,osd-tag-,.png]</texture>
            </control>
        </control>
        <control type="grouplist">
            <left>73</left>
            <top>108</top>
            <width>1600</width>
            <height>34</height>
            <orientation>horizontal</orientation>
            <itemgap>10</itemgap>
            <aligny>center</aligny>
            <visible>!VideoPlayer.Content(episodes) + !VideoPlayer.Content(movies) + Integer.IsGreater(Player.Duration(h),0)</visible>
            <control type="label">
                <width>auto</width>
                <height>34</height>
                <font>font_aura_midi</font>
                <aligny>center</aligny>
                <label>$INFO[VideoPlayer.Duration(h)] h $INFO[VideoPlayer.Duration(mm)] min</label>
                <textcolor>DDFFFFFF</textcolor>
            </control>
            <control type="image">
                <width>40</width>
                <height>24</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[VideoPlayer.VideoResolution,osd-tag-,.png]</texture>
            </control>
        </control>

        <!-- Clock, top-right: naked text, right edge ~1839 (Plex) -->
        <control type="label">
            <left>1640</left>
            <top>53</top>
            <width>164</width>
            <height>40</height>
            <font>font_aura_mini</font>
            <align>right</align>
            <aligny>center</aligny>
            <label>$INFO[System.Time(h:mm)]</label>
            <textcolor>FFFFFFFF</textcolor>
        </control>
        <control type="label">
            <left>1807</left>
            <top>53</top>
            <width>44</width>
            <height>40</height>
            <aligny>center</aligny>
            <font>font_aura_mini</font>
            <label>AM</label>
            <textcolor>FFFFFFFF</textcolor>
            <visible>!Integer.IsGreater(System.Time(hh),11)</visible>
        </control>
        <control type="label">
            <left>1807</left>
            <top>53</top>
            <width>44</width>
            <height>40</height>
            <aligny>center</aligny>
            <font>font_aura_mini</font>
            <label>PM</label>
            <textcolor>FFFFFFFF</textcolor>
            <visible>Integer.IsGreater(System.Time(hh),11)</visible>
        </control>

        <!-- Play-queue + settings circles, bottom-right (Plex: ~76px
             circles, centers x~1743/1820, glyph center ~y900). Focused
             circle goes solid white with a dark glyph. -->
        <control type="button" id="9110">
            <left>1705</left>
            <top>862</top>
            <width>76</width>
            <height>76</height>
            <label></label>
            <onclick>RunScript(script.akasha.aura,osdqueue)</onclick>
            <onleft>9101</onleft>
            <onright>9111</onright>
            <ondown>9102</ondown>
            <texturenofocus colordiffuse="73FFFFFF">akasha-circle.png</texturenofocus>
            <texturefocus colordiffuse="FFFFFFFF">akasha-circle.png</texturefocus>
        </control>
        <control type="image">
            <left>1728</left>
            <top>885</top>
            <width>30</width>
            <height>30</height>
            <texture>osd-queue.png</texture>
            <visible>!Control.HasFocus(9110)</visible>
        </control>
        <control type="image">
            <left>1728</left>
            <top>885</top>
            <width>30</width>
            <height>30</height>
            <texture colordiffuse="FF1F1614">osd-queue-dark.png</texture>
            <visible>Control.HasFocus(9110)</visible>
        </control>
        <control type="button" id="9111">
            <left>1782</left>
            <top>862</top>
            <width>76</width>
            <height>76</height>
            <label></label>
            <onclick>RunScript(script.akasha.aura,osdmenu,quality)</onclick>
            <onleft>9110</onleft>
            <ondown>9102</ondown>
            <texturenofocus colordiffuse="73FFFFFF">akasha-circle.png</texturenofocus>
            <texturefocus colordiffuse="FFFFFFFF">akasha-circle.png</texturefocus>
        </control>
        <control type="image">
            <left>1805</left>
            <top>885</top>
            <width>30</width>
            <height>30</height>
            <texture>osd/settings.png</texture>
            <visible>!Control.HasFocus(9111)</visible>
        </control>
        <control type="image">
            <left>1805</left>
            <top>885</top>
            <width>30</width>
            <height>30</height>
            <texture colordiffuse="FF1F1614">osd/settings.png</texture>
            <visible>Control.HasFocus(9111)</visible>
        </control>

        <!-- Bottom bar: naked play/pause glyph (Plex ~21x23 at
             x80,y963), elapsed, seek track + knob, remaining -->
        <control type="button" id="9100">
            <left>62</left>
            <top>946</top>
            <width>56</width>
            <height>56</height>
            <label></label>
            <onclick>PlayerControl(Play)</onclick>
            <onright>9101</onright>
            <onup>9110</onup>
            <texturenofocus>-</texturenofocus>
            <texturefocus colordiffuse="1AFFFFFF">akasha-circle.png</texturefocus>
        </control>
        <control type="image">
            <left>60</left>
            <top>946</top>
            <width>64</width>
            <height>64</height>
            <aspectratio>keep</aspectratio>
            <texture>osd/pause.png</texture>
            <visible>!Player.Paused</visible>
        </control>
        <control type="image">
            <left>56</left>
            <top>947</top>
            <width>64</width>
            <height>64</height>
            <aspectratio>keep</aspectratio>
            <texture>osd/play.png</texture>
            <visible>Player.Paused</visible>
        </control>
        <control type="label">
            <left>148</left>
            <top>954</top>
            <width>110</width>
            <height>40</height>
            <font>font_aura_clock</font>
            <aligny>center</aligny>
            <label>$INFO[Player.Time(m)]:$INFO[Player.Time(ss)]</label>
            <textcolor>FFFFFFFF</textcolor>
            <visible>!Integer.IsGreater(Player.Duration(h),0)</visible>
        </control>
        <control type="label">
            <left>148</left>
            <top>954</top>
            <width>110</width>
            <height>40</height>
            <font>font_aura_clock</font>
            <aligny>center</aligny>
            <label>$INFO[Player.Time(h:mm:ss)]</label>
            <textcolor>FFFFFFFF</textcolor>
            <visible>Integer.IsGreater(Player.Duration(h),0)</visible>
        </control>
        <!-- Seek visuals: a passive progress draws the gray track + amber
             played fill (Plex accent), the interactive slider above it
             only renders the 24px white knob at the playhead. -->
        <control type="progress">
            <left>222</left>
            <top>969</top>
            <width>1500</width>
            <height>12</height>
            <info>Player.Progress</info>
            <texturebg colordiffuse="5EFFFFFF" border="6">progress/progress-bg.png</texturebg>
        </control>
        <control type="progress">
            <left>222</left>
            <top>969</top>
            <width>1500</width>
            <height>12</height>
            <info>Player.Progress</info>
            <texturebg colordiffuse="00FFFFFF">progress/progress-bg.png</texturebg>
            <lefttexture colordiffuse="FFE5A00D" border="2">progress/progress-left.png</lefttexture>
            <midtexture colordiffuse="FFE5A00D" border="2">progress/progress-end.png</midtexture>
            <righttexture colordiffuse="FFE5A00D" border="2">progress/progress-right.png</righttexture>
            <overlaytexture></overlaytexture>
        </control>
        <control type="slider" id="9101">
            <left>222</left>
            <top>957</top>
            <width>1500</width>
            <height>36</height>
            <info>Player.Progress</info>
            <action>seek</action>
            <texturesliderbar colordiffuse="00FFFFFF">progress/slider_bg.png</texturesliderbar>
            <textureslidernib colordiffuse="FFFFFFFF">osd-nib.png</textureslidernib>
            <textureslidernibfocus colordiffuse="FFFFFFFF">osd-nib.png</textureslidernibfocus>
            <onleft>9100</onleft>
            <onup>9110</onup>
            <ondown>9102</ondown>
        </control>
        <control type="label">
            <left>1638</left>
            <top>954</top>
            <width>204</width>
            <height>40</height>
            <font>font_aura_clock</font>
            <align>right</align>
            <aligny>center</aligny>
            <label>-$INFO[Player.TimeRemaining(m)]:$INFO[Player.TimeRemaining(ss)]</label>
            <textcolor>FFFFFFFF</textcolor>
            <visible>!Integer.IsGreater(Player.Duration(h),0)</visible>
        </control>
        <control type="label">
            <left>1638</left>
            <top>954</top>
            <width>204</width>
            <height>40</height>
            <font>font_aura_clock</font>
            <align>right</align>
            <aligny>center</aligny>
            <label>-$INFO[Player.TimeRemaining(h:mm:ss)]</label>
            <textcolor>FFFFFFFF</textcolor>
            <visible>Integer.IsGreater(Player.Duration(h),0)</visible>
        </control>

        <!-- Chapters/queue chevron (Plex: thin ~20px V at y~1007) -->
        <control type="button" id="9102">
            <left>925</left>
            <top>990</top>
            <width>70</width>
            <height>40</height>
            <label></label>
            <onclick>RunScript(script.akasha.aura,osdqueue)</onclick>
            <onup>9101</onup>
            <texturenofocus>-</texturenofocus>
            <texturefocus>-</texturefocus>
        </control>
        <control type="image">
            <left>949</left>
            <top>1006</top>
            <width>22</width>
            <height>10</height>
            <texture>osd-chev.png</texture>
        </control>
    </controls>
</window>
