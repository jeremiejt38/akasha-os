<?xml version="1.0" encoding="UTF-8"?>
<!-- Akasha Plex-style VideoOSD (replaces Arctic Horizon 2's).
     Mirrors the Android TV OSD measured in docs/plex-parity/reference/lecteur/:
     title + SxEx/show/duration top-left, clock top-right, slim seek bar
     bottom with play/pause + times, subtitle and settings circles at the
     bottom-right, a down chevron to dismiss. -->
<window>
    <defaultcontrol>9100</defaultcontrol>
    <controls>
        <!-- Scrim gradients for readability -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>220</height>
            <texture>akasha-osd-scrim-top.png</texture>
        </control>
        <control type="image">
            <left>0</left>
            <top>860</top>
            <width>1920</width>
            <height>220</height>
            <texture>akasha-osd-scrim-bottom.png</texture>
        </control>

        <!-- Title block, top-left -->
        <control type="label">
            <left>105</left>
            <top>50</top>
            <width>1400</width>
            <height>48</height>
            <font>font_mini_bold</font>
            <label>$INFO[VideoPlayer.Title]</label>
            <textcolor>FFFFFFFF</textcolor>
        </control>
        <control type="label">
            <left>105</left>
            <top>96</top>
            <width>1400</width>
            <height>34</height>
            <font>font_mini</font>
            <label>$INFO[VideoPlayer.Season,S] • E$INFO[VideoPlayer.Episode] • $INFO[VideoPlayer.TvShowTitle] • $INFO[VideoPlayer.Duration(mins)] $ADDON[script.akasha.aura 33585] • $INFO[VideoPlayer.VideoResolution]</label>
            <textcolor>DDFFFFFF</textcolor>
            <visible>VideoPlayer.Content(episodes) + !Integer.IsGreater(Player.Duration(h),0)</visible>
        </control>
        <control type="label">
            <left>105</left>
            <top>96</top>
            <width>1400</width>
            <height>34</height>
            <font>font_mini</font>
            <label>$INFO[VideoPlayer.Season,S] • E$INFO[VideoPlayer.Episode] • $INFO[VideoPlayer.TvShowTitle] • $INFO[VideoPlayer.Duration(h)] h $INFO[VideoPlayer.Duration(mm)] min • $INFO[VideoPlayer.VideoResolution]</label>
            <textcolor>DDFFFFFF</textcolor>
            <visible>VideoPlayer.Content(episodes) + Integer.IsGreater(Player.Duration(h),0)</visible>
        </control>
        <control type="label">
            <left>105</left>
            <top>96</top>
            <width>1400</width>
            <height>34</height>
            <font>font_mini</font>
            <label>$INFO[VideoPlayer.Year] • $INFO[VideoPlayer.Duration(mins)] $ADDON[script.akasha.aura 33585] • $INFO[VideoPlayer.VideoResolution]</label>
            <textcolor>DDFFFFFF</textcolor>
            <visible>VideoPlayer.Content(movies) + !Integer.IsGreater(Player.Duration(h),0)</visible>
        </control>
        <control type="label">
            <left>105</left>
            <top>96</top>
            <width>1400</width>
            <height>34</height>
            <font>font_mini</font>
            <label>$INFO[VideoPlayer.Year] • $INFO[VideoPlayer.Duration(h)] h $INFO[VideoPlayer.Duration(mm)] min • $INFO[VideoPlayer.VideoResolution]</label>
            <textcolor>DDFFFFFF</textcolor>
            <visible>VideoPlayer.Content(movies) + Integer.IsGreater(Player.Duration(h),0)</visible>
        </control>
        <control type="label">
            <left>105</left>
            <top>96</top>
            <width>1400</width>
            <height>34</height>
            <font>font_mini</font>
            <label>$INFO[VideoPlayer.Duration(mins)] $ADDON[script.akasha.aura 33585] • $INFO[VideoPlayer.VideoResolution]</label>
            <textcolor>DDFFFFFF</textcolor>
            <visible>!VideoPlayer.Content(episodes) + !VideoPlayer.Content(movies) + !Integer.IsGreater(Player.Duration(h),0)</visible>
        </control>
        <control type="label">
            <left>105</left>
            <top>96</top>
            <width>1400</width>
            <height>34</height>
            <font>font_mini</font>
            <label>$INFO[VideoPlayer.Duration(h)] h $INFO[VideoPlayer.Duration(mm)] min • $INFO[VideoPlayer.VideoResolution]</label>
            <textcolor>DDFFFFFF</textcolor>
            <visible>!VideoPlayer.Content(episodes) + !VideoPlayer.Content(movies) + Integer.IsGreater(Player.Duration(h),0)</visible>
        </control>

        <!-- Clock, top-right -->
        <control type="label">
            <left>1640</left>
            <top>50</top>
            <width>200</width>
            <height>48</height>
            <font>font_mini</font>
            <align>right</align>
            <label>$INFO[System.Time]</label>
            <textcolor>FFFFFFFF</textcolor>
        </control>

        <!-- Chapters + subtitle + settings circles, bottom-right. The
             chapters circle only renders when the playing file carries
             more than one chapter (B14). -->
        <control type="button" id="9112">
            <left>1570</left>
            <top>828</top>
            <width>64</width>
            <height>64</height>
            <label></label>
            <onclick>RunScript(script.akasha.aura,osdmenu,chapters)</onclick>
            <onleft>9100</onleft>
            <onright>9110</onright>
            <ondown>9101</ondown>
            <texturenofocus colordiffuse="73FFFFFF">akasha-circle.png</texturenofocus>
            <texturefocus colordiffuse="FFFFFFFF">akasha-circle.png</texturefocus>
            <visible>Integer.IsGreater(Player.ChapterCount,1) | !String.IsEmpty(Window(10000).Property(AuraPlaybackChapters))</visible>
        </control>
        <control type="image">
            <left>1586</left>
            <top>844</top>
            <width>32</width>
            <height>32</height>
            <texture>akasha-chapters.png</texture>
            <visible>Integer.IsGreater(Player.ChapterCount,1) | !String.IsEmpty(Window(10000).Property(AuraPlaybackChapters))</visible>
        </control>
        <control type="button" id="9110">
            <left>1650</left>
            <top>828</top>
            <width>64</width>
            <height>64</height>
            <label></label>
            <onclick>RunScript(script.akasha.aura,osdmenu,streams)</onclick>
            <onleft>9112</onleft>
            <onright>9111</onright>
            <ondown>9101</ondown>
            <texturenofocus colordiffuse="73FFFFFF">akasha-circle.png</texturenofocus>
            <texturefocus colordiffuse="FFFFFFFF">akasha-circle.png</texturefocus>
        </control>
        <control type="image">
            <left>1666</left>
            <top>844</top>
            <width>32</width>
            <height>32</height>
            <texture>osd/subs.png</texture>
        </control>
        <control type="button" id="9111">
            <left>1730</left>
            <top>828</top>
            <width>64</width>
            <height>64</height>
            <label></label>
            <onclick>RunScript(script.akasha.aura,osdmenu,quality)</onclick>
            <onleft>9110</onleft>
            <ondown>9101</ondown>
            <texturenofocus colordiffuse="73FFFFFF">akasha-circle.png</texturenofocus>
            <texturefocus colordiffuse="FFFFFFFF">akasha-circle.png</texturefocus>
        </control>
        <control type="image">
            <left>1746</left>
            <top>844</top>
            <width>32</width>
            <height>32</height>
            <texture>osd/settings.png</texture>
        </control>

        <!-- Bottom bar: play/pause, time, seek, remaining -->
        <control type="button" id="9100">
            <left>70</left>
            <top>912</top>
            <width>56</width>
            <height>56</height>
            <label></label>
            <onclick>PlayerControl(Play)</onclick>
            <onright>9101</onright>
            <onup>9110</onup>
            <texturenofocus>-</texturenofocus>
            <texturefocus colordiffuse="33FFFFFF">akasha-circle.png</texturefocus>
        </control>
        <control type="image">
            <left>82</left>
            <top>924</top>
            <width>32</width>
            <height>32</height>
            <texture>osd/pause.png</texture>
            <visible>!Player.Paused</visible>
        </control>
        <control type="image">
            <left>82</left>
            <top>924</top>
            <width>32</width>
            <height>32</height>
            <texture>osd/play.png</texture>
            <visible>Player.Paused</visible>
        </control>
        <control type="label">
            <left>140</left>
            <top>918</top>
            <width>110</width>
            <height>44</height>
            <font>font_mini</font>
            <aligny>center</aligny>
            <label>$INFO[Player.Time(m)]:$INFO[Player.Time(ss)]</label>
            <textcolor>FFFFFFFF</textcolor>
            <visible>!Integer.IsGreater(Player.Duration(h),0)</visible>
        </control>
        <control type="label">
            <left>140</left>
            <top>918</top>
            <width>110</width>
            <height>44</height>
            <font>font_mini</font>
            <aligny>center</aligny>
            <label>$INFO[Player.Time(h:mm:ss)]</label>
            <textcolor>FFFFFFFF</textcolor>
            <visible>Integer.IsGreater(Player.Duration(h),0)</visible>
        </control>
        <!-- Seek visuals: a passive progress draws the gray track + amber
             played fill (Plex accent), the interactive slider above it only
             renders the white thumb. -->
        <control type="progress">
            <left>250</left>
            <top>937</top>
            <width>1380</width>
            <height>6</height>
            <info>Player.Progress</info>
            <texturebg colordiffuse="59FFFFFF" border="4">progress/progress-bg.png</texturebg>
        </control>
        <control type="progress">
            <left>250</left>
            <top>937</top>
            <width>1380</width>
            <height>6</height>
            <info>Player.Progress</info>
            <texturebg colordiffuse="00FFFFFF">progress/progress-bg.png</texturebg>
            <lefttexture colordiffuse="FFE5A00D" border="2">progress/progress-left.png</lefttexture>
            <midtexture colordiffuse="FFE5A00D" border="2">progress/progress-end.png</midtexture>
            <righttexture colordiffuse="FFE5A00D" border="2">progress/progress-right.png</righttexture>
            <overlaytexture></overlaytexture>
        </control>
        <control type="slider" id="9101">
            <left>250</left>
            <top>928</top>
            <width>1380</width>
            <height>24</height>
            <info>Player.Progress</info>
            <action>seek</action>
            <texturesliderbar colordiffuse="00FFFFFF">progress/slider_bg.png</texturesliderbar>
            <textureslidernib colordiffuse="FFFFFFFF">progress/slider_nib.png</textureslidernib>
            <textureslidernibfocus colordiffuse="FFFFFFFF">progress/slider_nib.png</textureslidernibfocus>
            <onleft>9100</onleft>
            <onup>9110</onup>
            <ondown>9102</ondown>
        </control>
        <control type="label">
            <left>1660</left>
            <top>918</top>
            <width>180</width>
            <height>44</height>
            <font>font_mini</font>
            <align>right</align>
            <aligny>center</aligny>
            <label>-$INFO[Player.TimeRemaining(m)]:$INFO[Player.TimeRemaining(ss)]</label>
            <textcolor>FFFFFFFF</textcolor>
            <visible>!Integer.IsGreater(Player.Duration(h),0)</visible>
        </control>
        <control type="label">
            <left>1660</left>
            <top>918</top>
            <width>180</width>
            <height>44</height>
            <font>font_mini</font>
            <align>right</align>
            <aligny>center</aligny>
            <label>-$INFO[Player.TimeRemaining(h:mm:ss)]</label>
            <textcolor>FFFFFFFF</textcolor>
            <visible>Integer.IsGreater(Player.Duration(h),0)</visible>
        </control>

        <!-- Dismiss chevron -->
        <control type="button" id="9102">
            <left>930</left>
            <top>1000</top>
            <width>60</width>
            <height>40</height>
            <label></label>
            <onclick>Action(Back)</onclick>
            <onup>9101</onup>
            <texturenofocus>-</texturenofocus>
            <texturefocus>-</texturefocus>
        </control>
        <control type="image">
            <left>940</left>
            <top>1010</top>
            <width>40</width>
            <height>24</height>
            <texture colordiffuse="CCFFFFFF">akasha-chev-down.png</texture>
        </control>
    </controls>
</window>
